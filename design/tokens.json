  "_app_brushes": "Brushes the WPF app needs that are more than one colour, generated into both Tokens dictionaries so they swap with the theme. 'surface' is an elevation: the base colour with its top highlight composited onto the first pixel row. 'linear' and 'radial' are gradients between tokens. 'shadow' is a DropShadowEffect falling straight down; its opacity differs per theme.",
  "app_brushes": {
    "Elev1Surface": { "kind": "surface", "base": "elev-1", "top": "highlight-1" },
    "Elev2Surface": { "kind": "surface", "base": "elev-2", "top": "highlight-2" },
    "Elev3Surface": { "kind": "surface", "base": "elev-3", "top": "highlight-3" },
    "PrimaryGradient": { "kind": "linear", "from": "primary-grad-top", "to": "primary-grad-bottom", "start": "0,0", "end": "0,1" },
    "RingGradient": { "kind": "linear", "from": "ring-grad-start", "to": "ring-grad-end", "start": "0,0", "end": "1,1" },
    "GlowGradient": {
      "kind": "radial",
      "from": "glow",
      "to": { "ref": "glow", "alpha": 0 }
    },
    "ShadowE1": {
      "kind": "shadow",
      "blur": 6,
      "depth": 2,
      "opacity": { "dark": 0.3, "light": 0.07 }
    },
    "ShadowE2": {
      "kind": "shadow",
      "blur": 28,
      "depth": 10,
      "opacity": { "dark": 0.4, "light": 0.11 }
