  "css_only": {
    "light": {
      "depth-e1": "inset 0 1px 0 var(--color-highlight-1), 0 0 0 1px var(--color-hairline), 0 1px 2px rgba(22, 24, 26, 0.07), 0 2px 6px rgba(22, 24, 26, 0.05)",
      "depth-e2": "inset 0 1px 0 var(--color-highlight-2), 0 0 0 1px var(--color-hairline), 0 2px 4px rgba(22, 24, 26, 0.07), 0 12px 28px rgba(22, 24, 26, 0.11)",
      "depth-e3": "inset 0 1px 0 var(--color-highlight-3), 0 0 0 1px var(--color-hairline), 0 8px 16px rgba(22, 24, 26, 0.12), 0 28px 64px rgba(22, 24, 26, 0.22)",
      "depth-capture": "0 0 0 1px var(--color-hairline), 0 8px 16px rgba(22, 24, 26, 0.12), 0 28px 64px rgba(22, 24, 26, 0.22)",
      "depth-control": "inset 0 0 0 1px var(--color-control-edge), inset 0 -1px 0 var(--color-control-shadow), 0 1px 1px rgba(22, 24, 26, 0.05)",
      "depth-primary": "inset 0 1px 0 var(--color-primary-highlight), inset 0 0 0 1px var(--color-primary-edge), 0 1px 2px var(--color-primary-shadow), 0 3px 8px rgba(22, 24, 26, 0.14)"
    },
    "dark": {
      "depth-e1": "inset 0 1px 0 var(--color-highlight-1), 0 0 0 1px var(--color-hairline), 0 1px 2px rgba(0, 0, 0, 0.3), 0 2px 6px rgba(0, 0, 0, 0.16)",
