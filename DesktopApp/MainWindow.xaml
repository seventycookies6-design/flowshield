<Window x:Class="FlowShield.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FlowShield.Views"
        xmlns:vm="clr-namespace:FlowShield.ViewModels"
        xmlns:models="clr-namespace:FlowShield.Models"
        Title="FlowShield" Icon="Assets/FlowShield.ico"
        Height="760" Width="1180"
        MinHeight="540" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource FontStack}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AutomationProperties.AutomationId="FlowShieldMainWindow">

    <!-- Sprint progress on the taskbar button, updated from the tray code (F19). -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo/>
    </Window.TaskbarItemInfo>


    <Grid x:Name="RootGrid" SizeChanged="OnSizeChanged">
        <Grid.ColumnDefinitions>
            <!-- 240px per DESIGN_SYSTEM.md §4's nav-rail width (A2, issue #147);
                 was 238px, one pixel short of the spec on each of two edges. -->
            <ColumnDefinition x:Name="NavColumn" Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================== navigation rail -->
        <Border Grid.Column="0" Background="{StaticResource BgSoft}" BorderBrush="{StaticResource Edge}"
                BorderThickness="0,0,1,0">
            <DockPanel x:Name="NavDockPanel" Margin="16,24,16,16">

                <!-- brand -->
                <StackPanel x:Name="NavBrand" DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
                    <Canvas Width="26" Height="26" VerticalAlignment="Center">
                        <Path Data="M13 1.6 3.2 5.4v7.6c0 5.5 3.9 9.7 9.8 11.1 5.9-1.4 9.8-5.6 9.8-11.1V5.4L13 1.6Z"
                              Fill="{StaticResource PrimarySoft}" Stroke="{StaticResource Primary}" StrokeThickness="1.4"/>
                        <Path Data="M8.9 13.3 11.8 16.2 17.6 9.9"
                              Stroke="{StaticResource Primary}" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                    <TextBlock x:Name="NavBrandText" Text="FlowShield" Style="{StaticResource H2}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- tier + upgrade, pinned to the bottom -->
                <!-- Collapsed as a whole at narrow widths. The Buy button keeps its own
                     IsNotPro binding: setting Visibility on it from code would replace
                     that binding and show the button to paying customers. -->
                <StackPanel x:Name="NavBottomPanel" DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource BtnPrimary}"
                            Content="Buy FlowShield — $4.99"
                            Command="{Binding GetProCommand}"
                            AutomationProperties.AutomationId="GetProNavButton"
                            AutomationProperties.Name="Buy FlowShield"
                            Visibility="{Binding IsNotPro, Converter={StaticResource BoolVis}}"
                            Margin="0,0,0,12"/>

                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Padding="12,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{Binding TierBadgeDotKey, Converter={StaticResource ResourceKeyToBrush}}"
                                     AutomationProperties.AutomationId="TierBadgeDot"
                                     Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding TierBadge}" Style="{StaticResource Eyebrow}"
                                       AutomationProperties.AutomationId="TierBadge"
                                       Foreground="{StaticResource InkDim}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- tabs -->
                <StackPanel x:Name="NavTabs" DockPanel.Dock="Top">
                    <Button Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Today"
                            Tag="{Binding IsTodayPage}"
                            AutomationProperties.AutomationId="Tab_Today"
                            AutomationProperties.Name="Today">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconToday}"/>
                            <TextBlock x:Name="NavTodayLabel" Text="Today" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="History"
                            Tag="{Binding IsHistoryPage}"
                            AutomationProperties.AutomationId="Tab_History"
                            AutomationProperties.Name="History">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconHistory}"/>
                            <TextBlock x:Name="NavHistoryLabel" Text="History" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="BlockedApps"
                            Tag="{Binding IsBlockedAppsPage}"
                            AutomationProperties.AutomationId="Tab_BlockedApps"
                            AutomationProperties.Name="Blocked Apps">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconBlocked}"/>
                            <TextBlock x:Name="NavBlockedAppsLabel" Text="Blocked Apps" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="SleepBlocking"
                            Tag="{Binding IsSleepBlockingPage}"
                            AutomationProperties.AutomationId="Tab_SleepBlocking"
                            AutomationProperties.Name="Sleep Blocking">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconSleep}"/>
                            <TextBlock x:Name="NavSleepBlockingLabel" Text="Sleep Blocking" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Settings"
                            Tag="{Binding IsSettingsPage}"
                            AutomationProperties.AutomationId="Tab_Settings"
                            AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconSettings}"/>
                            <TextBlock x:Name="NavSettingsLabel" Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- ========================================================== content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="32,32,32,16">
                <TextBlock Text="{Binding CurrentPageTitle}" Style="{StaticResource H1}"
                           AutomationProperties.AutomationId="PageTitle"/>
                <TextBlock Text="{Binding CurrentPageSubtitle}" Style="{StaticResource Body}" Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="32,0,32,24">
                <views:TodayView DataContext="{Binding Today}"
                                 Visibility="{Binding DataContext.IsTodayPage,
                                              RelativeSource={RelativeSource AncestorType=Window},
                                              Converter={StaticResource BoolVis}}"/>

                <views:HistoryView DataContext="{Binding History}"
                                   Visibility="{Binding DataContext.IsHistoryPage,
                                                RelativeSource={RelativeSource AncestorType=Window},
                                                Converter={StaticResource BoolVis}}"/>

                <views:BlockedAppsView DataContext="{Binding BlockedApps}"
                                       Visibility="{Binding DataContext.IsBlockedAppsPage,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource BoolVis}}"/>

                <views:SleepBlockingView DataContext="{Binding SleepBlocking}"
                                         Visibility="{Binding DataContext.IsSleepBlockingPage,
                                                      RelativeSource={RelativeSource AncestorType=Window},
                                                      Converter={StaticResource BoolVis}}"/>

                <views:SettingsView DataContext="{Binding SettingsPage}"
                                    Visibility="{Binding DataContext.IsSettingsPage,
                                                 RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BoolVis}}"/>
            </Grid>

            <!-- ===================================================== lock screen -->
            <!-- Covers every page once the free trial ends without a purchase.
                 The nav rail stays usable so the user can still look around,
                 but nothing behind this can be operated. -->
            <Border Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource Scrim}"
                    Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}"
                    AutomationProperties.AutomationId="TrialEndedPanel">
                <Border Style="{StaticResource Card}" Padding="32" MaxWidth="520"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="FREE TRIAL ENDED" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Keep FlowShield for $4.99" Style="{StaticResource H1}"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding TrialEndedText}" Style="{StaticResource Body}"
                                   TextWrapping="Wrap" Margin="0,12,0,0"
                                   AutomationProperties.AutomationId="TrialEndedText"/>

                        <Button Style="{StaticResource BtnPrimary}" Content="Buy FlowShield — $4.99"
                                Command="{Binding GetProCommand}" Padding="24,12" Margin="0,24,0,0"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="LockBuyButton"
                                AutomationProperties.Name="Buy FlowShield"/>

                        <Border Height="1" Background="{StaticResource Edge}" Margin="0,24,0,16"/>

                        <TextBlock Text="ALREADY BOUGHT IT?" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource Field}"
                                 Text="{Binding SettingsPage.LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Mono, Consolas, monospace"
                                 AutomationProperties.AutomationId="LockLicenseKeyInput"
                                 AutomationProperties.Name="License key"
                                 AutomationProperties.HelpText="FS-XXXX-XXXX-XXXX-XXXX"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource BtnGhost}" Content="Activate licence"
                                    Command="{Binding SettingsPage.ActivateCommand}"
                                    AutomationProperties.AutomationId="LockActivateButton"
                                    AutomationProperties.Name="Activate licence"/>
                            <TextBlock Text="Checking…" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding SettingsPage.IsBusy, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SettingsPage.LicenseDetailText}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,12,0,0"
                                   AutomationProperties.AutomationId="LockLicenseDetailText"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ================================================= first run (F18) -->
            <Border Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource Scrim}"
                    DataContext="{Binding FirstRun}"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolVis}}"
                    AutomationProperties.AutomationId="FirstRunPanel">
                <Border Style="{StaticResource Card}" Padding="32,24" Width="600" MaxWidth="600" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <DockPanel>
                        <!-- header -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                            <TextBlock Text="{Binding StepText}" Style="{StaticResource Eyebrow}"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="FirstRunStepText"/>
                            <Button Style="{StaticResource BtnQuiet}" Content="Skip setup" HorizontalAlignment="Right"
                                    Command="{Binding SkipCommand}"
                                    AutomationProperties.AutomationId="FirstRunSkipButton"
                                    AutomationProperties.Name="Skip setup"/>
                        </Grid>

                        <!-- footer -->
                        <Grid DockPanel.Dock="Bottom" Margin="0,24,0,0">
                            <Button Style="{StaticResource BtnQuiet}" Content="Back" HorizontalAlignment="Left"
                                    Command="{Binding BackCommand}"
                                    Visibility="{Binding IsStep1, Converter={StaticResource InvBoolVis}}"
                                    AutomationProperties.AutomationId="FirstRunBackButton"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource BtnPrimary}" Content="Next" Padding="24,12"
                                        Command="{Binding NextCommand}"
                                        Visibility="{Binding NextVisible, Converter={StaticResource BoolVis}}"
                                        AutomationProperties.AutomationId="FirstRunNextButton"/>
                                <Button Style="{StaticResource BtnQuiet}" Content="Finish without starting"
                                        Command="{Binding FinishCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding IsStep3, Converter={StaticResource BoolVis}}"
                                        AutomationProperties.AutomationId="FirstRunFinishButton"/>
                                <Button Style="{StaticResource BtnPrimary}" Content="Start my first sprint" Padding="24,12"
                                        Command="{Binding StartCommand}"
                                        Visibility="{Binding IsStep3, Converter={StaticResource BoolVis}}"
                                        AutomationProperties.AutomationId="FirstRunStartButton"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <!-- step 1: what distracts you -->
                            <DockPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolVis}}">
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="What pulls you away?" Style="{StaticResource H1}"/>
                                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,8,0,16"
                                               Text="Tick the apps FlowShield should block during a sprint. The ones on this PC are ticked for you to confirm."/>
                                    <TextBox Style="{StaticResource Field}" Margin="0,0,0,12"
                                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FirstRunSearchInput"
                                             AutomationProperties.Name="Search apps"/>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Apps}" MaxHeight="300" MinHeight="160"
                                         Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource PlainItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.AutomationId="FirstRunAppList"
                                         AutomationProperties.Name="Apps to block">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanToggle}"
                                                      Margin="0,0,0,8" VerticalContentAlignment="Center"
                                                      AutomationProperties.AutomationId="{Binding AutomationId}"
                                                      AutomationProperties.Name="{Binding Entry.Name}">
                                                <Grid Margin="8,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="26" Height="26" Margin="0,0,12,0">
                                                        <Border CornerRadius="{StaticResource RadiusControl}" Background="{StaticResource PrimarySoft}"
                                                                Visibility="{Binding Entry.HasIcon, Converter={StaticResource InvBoolVis}}">
                                                            <TextBlock Text="{Binding Entry.Initial}" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Ink}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Image Source="{Binding Entry.Icon}" Width="22" Height="22"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Entry.Name}" Foreground="{StaticResource Ink}"
                                                                   FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}"/>
                                                        <TextBlock Text="{Binding Entry.Note}" Style="{StaticResource Caption}"
                                                                   Foreground="{StaticResource Amber}" TextWrapping="Wrap"
                                                                   Visibility="{Binding Entry.HasNote, Converter={StaticResource BoolVis}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- step 2: how strict -->
                            <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="How strict should the shield be?" Style="{StaticResource H1}"/>
                                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,8,0,16"
                                           Text="You can change this before any sprint."/>
                                <RadioButton GroupName="FirstRunShield" Margin="0,0,0,12"
                                             IsChecked="{Binding Shield, Converter={StaticResource EnumEq},
                                                         ConverterParameter={x:Static models:ShieldLevel.Soft}}"
                                             AutomationProperties.AutomationId="FirstRunShield_Soft"
                                             AutomationProperties.Name="Soft">
                                     <StackPanel Margin="8,0,0,0">
                                         <TextBlock Text="Soft" Foreground="{StaticResource Ink}" FontWeight="SemiBold"/>
                                         <TextBlock Text="{Binding SoftPromise}" Style="{StaticResource Caption}"
                                                    AutomationProperties.AutomationId="FirstRunSoftPromise"/>
                                         <TextBlock Text="{Binding SoftBestFor}" Style="{StaticResource Caption}"
                                                    AutomationProperties.AutomationId="FirstRunSoftBestFor"/>
                                     </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="FirstRunShield" Margin="0,0,0,12"
                                             IsChecked="{Binding Shield, Converter={StaticResource EnumEq},
                                                         ConverterParameter={x:Static models:ShieldLevel.Firm}}"
                                             AutomationProperties.AutomationId="FirstRunShield_Firm"
                                             AutomationProperties.Name="Firm (recommended)">
                                     <StackPanel Margin="8,0,0,0">
                                         <TextBlock Foreground="{StaticResource Ink}" FontWeight="SemiBold">
                                             <Run Text="Firm"/><Run Text="  recommended" Foreground="{StaticResource Primary}" FontWeight="Normal"/>
                                         </TextBlock>
                                         <TextBlock Text="{Binding FirmPromise}" Style="{StaticResource Caption}"
                                                    AutomationProperties.AutomationId="FirstRunFirmPromise"/>
                                         <TextBlock Text="{Binding FirmBestFor}" Style="{StaticResource Caption}"
                                                    AutomationProperties.AutomationId="FirstRunFirmBestFor"/>
                                     </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="FirstRunShield"
                                             IsChecked="{Binding Shield, Converter={StaticResource EnumEq},
                                                         ConverterParameter={x:Static models:ShieldLevel.Sealed}}"
                                             AutomationProperties.AutomationId="FirstRunShield_Sealed"
                                             AutomationProperties.Name="Sealed">
                                     <StackPanel Margin="8,0,0,0">
                                         <TextBlock Text="Sealed" Foreground="{StaticResource Ink}" FontWeight="SemiBold"/>
                                         <TextBlock Text="{Binding SealedPromise}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                    AutomationProperties.AutomationId="FirstRunSealedPromise"/>
                                         <TextBlock Text="{Binding SealedBestFor}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                    AutomationProperties.AutomationId="FirstRunSealedBestFor"/>
                                     </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <!-- step 3: first sprint -->
                            <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="Your first sprint" Style="{StaticResource H1}"/>
                                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,8,0,16"
                                           Text="Pick a length. The shield runs until the time is up."/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="FirstRunLength" Content="25 min"
                                                 Margin="0,0,8,0"
                                                 IsChecked="{Binding Minutes, Converter={StaticResource IntEq}, ConverterParameter=25}"
                                                 AutomationProperties.AutomationId="FirstRunLength_25"
                                                 AutomationProperties.Name="25 minutes"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="FirstRunLength" Content="45 min"
                                                 IsChecked="{Binding Minutes, Converter={StaticResource IntEq}, ConverterParameter=45}"
                                                 AutomationProperties.AutomationId="FirstRunLength_45"
                                                 AutomationProperties.Name="45 minutes"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}"
                                          Margin="0,24,0,0"
                                          AutomationProperties.AutomationId="FirstRunStartWithWindows"
                                          AutomationProperties.Name="Start FlowShield with Windows">
                                    <StackPanel>
                                        <TextBlock Text="Start FlowShield with Windows" Foreground="{StaticResource Ink}"/>
                                        <TextBlock Text="Opens quietly in the tray when you sign in, so a sprint survives a restart."
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Text="{Binding TrialLine}" Style="{StaticResource Caption}" Margin="0,24,0,0"
                                           Visibility="{Binding HasTrialLine, Converter={StaticResource BoolVis}}"
                                           AutomationProperties.AutomationId="FirstRunTrialText"/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Border>

            <!-- ============================================ activation link (1.4) -->
            <!-- Sits above the lock screen, since that's exactly when a buyer
                 arrives from the success page. Nothing activates without Activate. -->
            <Border Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource Scrim}"
                    Visibility="{Binding ActivationPromptVisible, Converter={StaticResource BoolVis}}">
                <Border Style="{StaticResource Card}" Padding="32" MaxWidth="460"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="FROM YOUR PURCHASE" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Activate this licence?" Style="{StaticResource H2}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding PendingActivationKey}" FontFamily="Cascadia Mono, Consolas, monospace"
                                   Foreground="{StaticResource Ink}" FontSize="14" Margin="0,12,0,0"
                                   AutomationProperties.AutomationId="ActivationLinkKey"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="FlowShield will check this key with the licence server and unlock this device."/>
                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button Style="{StaticResource BtnPrimary}" Content="Activate" Padding="24,12"
                                    Command="{Binding ConfirmActivationCommand}"
                                    AutomationProperties.AutomationId="ConfirmActivationButton"
                                    AutomationProperties.Name="Activate"/>
                            <Button Style="{StaticResource BtnQuiet}" Content="Cancel" Margin="8,0,0,0"
                                    Command="{Binding DismissActivationCommand}"
                                    AutomationProperties.AutomationId="DismissActivationButton"
                                    AutomationProperties.Name="Cancel"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ============================================ terms gate (legal 2.3) -->
            <!-- Above every other panel, including the lock screen: nothing in
                 FlowShield should be usable before this is accepted. -->
            <Border Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource Scrim}"
                    Visibility="{Binding TermsGateVisible, Converter={StaticResource BoolVis}}"
                    AutomationProperties.AutomationId="TermsGatePanel">
                <Border Style="{StaticResource Card}" Padding="32,24" Width="560" MaxWidth="560" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="BEFORE YOU START" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="FlowShield closes programs" Style="{StaticResource H1}" Margin="0,8,0,0"/>

                        <TextBlock Text="{Binding TermsDataLossWarning}" Style="{StaticResource Body}"
                                   TextWrapping="Wrap" Margin="0,16,0,0"
                                   AutomationProperties.AutomationId="TermsDataLossText"/>

                        <TextBlock Text="{Binding TermsAgreementLine}" Style="{StaticResource Body}"
                                   TextWrapping="Wrap" Margin="0,16,0,0"
                                   AutomationProperties.AutomationId="TermsAgreementText"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource BtnQuiet}" Content="Read the terms"
                                    Command="{Binding OpenTermsCommand}" Margin="-12,0,0,0"
                                    AutomationProperties.AutomationId="OpenTermsButton"/>
                            <Button Style="{StaticResource BtnQuiet}" Content="Read the privacy policy"
                                    Command="{Binding OpenPrivacyCommand}"
                                    AutomationProperties.AutomationId="OpenPrivacyButton"/>
                        </StackPanel>

                        <TextBlock Text="{Binding TermsVersionText}" Style="{StaticResource Caption}"
                                   Margin="0,16,0,0"
                                   AutomationProperties.AutomationId="TermsVersionText"/>

                        <Button Style="{StaticResource BtnPrimary}" Content="I understand and agree"
                                Padding="24,12" Margin="0,16,0,0" HorizontalAlignment="Left"
                                Command="{Binding AcceptTermsCommand}"
                                AutomationProperties.AutomationId="AcceptTermsButton"
                                AutomationProperties.Name="I understand and agree"/>

                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Text="If you don't agree, close FlowShield and uninstall it; if you have bought it, ask for a refund."/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- toast -->
            <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,24" CornerRadius="{StaticResource RadiusCard}" Padding="16,12"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource EdgeBright}" BorderThickness="1"
                    Visibility="{Binding ToastVisible, Converter={StaticResource BoolVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.55"/>
                </Border.Effect>
                <TextBlock Text="{Binding ToastText}" Style="{StaticResource Caption}" Foreground="{StaticResource Ink}"
                           AutomationProperties.AutomationId="ToastText"/>
            </Border>
        </Grid>
    </Grid>
</Window>
