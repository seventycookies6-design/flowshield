<Window x:Class="FlowShield.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FlowShield.Views"
        xmlns:vm="clr-namespace:FlowShield.ViewModels"
        Title="FlowShield"
        Height="760" Width="1180"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AutomationProperties.AutomationId="FlowShieldMainWindow">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================== navigation rail -->
        <Border Grid.Column="0" Background="{StaticResource BgSoft}" BorderBrush="{StaticResource Edge}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="18,22,18,18">

                <!-- brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                    <Canvas Width="26" Height="26" VerticalAlignment="Center">
                        <Path Data="M13 1.6 3.2 5.4v7.6c0 5.5 3.9 9.7 9.8 11.1 5.9-1.4 9.8-5.6 9.8-11.1V5.4L13 1.6Z"
                              Fill="{StaticResource PrimarySoft}" Stroke="{StaticResource Primary}" StrokeThickness="1.4"/>
                        <Path Data="M8.9 13.3 11.8 16.2 17.6 9.9"
                              Stroke="{StaticResource Primary}" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                    <TextBlock Text="FlowShield" Style="{StaticResource H2}" FontSize="15"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- tier + upgrade, pinned to the bottom -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource BtnPrimary}"
                            Content="Buy FlowShield — $4.99"
                            Command="{Binding GetProCommand}"
                            AutomationProperties.AutomationId="GetProNavButton"
                            AutomationProperties.Name="Buy FlowShield"
                            Visibility="{Binding IsNotPro, Converter={StaticResource BoolVis}}"
                            Margin="0,0,0,12"/>

                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Padding="11,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{StaticResource Green}" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding TierBadge}" Style="{StaticResource Eyebrow}"
                                       AutomationProperties.AutomationId="TierBadge"
                                       Foreground="{StaticResource InkDim}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- tabs -->
                <StackPanel DockPanel.Dock="Top">
                    <Button Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Today"
                            Tag="{Binding IsTodayPage}"
                            AutomationProperties.AutomationId="Tab_Today"
                            AutomationProperties.Name="Today">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◷" FontSize="15" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Today" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="BlockedApps"
                            Tag="{Binding IsBlockedAppsPage}"
                            AutomationProperties.AutomationId="Tab_BlockedApps"
                            AutomationProperties.Name="Blocked Apps">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊘" FontSize="15" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Blocked Apps" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="SleepBlocking"
                            Tag="{Binding IsSleepBlockingPage}"
                            AutomationProperties.AutomationId="Tab_SleepBlocking"
                            AutomationProperties.Name="Sleep Blocking">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☾" FontSize="15" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Sleep Blocking" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Settings"
                            Tag="{Binding IsSettingsPage}"
                            AutomationProperties.AutomationId="Tab_Settings"
                            AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="15" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- ========================================================== content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="34,28,34,18">
                <TextBlock Text="{Binding CurrentPageTitle}" Style="{StaticResource H1}"
                           AutomationProperties.AutomationId="PageTitle"/>
                <TextBlock Text="{Binding CurrentPageSubtitle}" Style="{StaticResource Body}" Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="34,0,34,26">
                <views:TodayView DataContext="{Binding Today}"
                                 Visibility="{Binding DataContext.IsTodayPage,
                                              RelativeSource={RelativeSource AncestorType=Window},
                                              Converter={StaticResource BoolVis}}"/>

                <views:BlockedAppsView DataContext="{Binding BlockedApps}"
                                       Visibility="{Binding DataContext.IsBlockedAppsPage,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource BoolVis}}"/>

                <views:SleepBlockingView DataContext="{Binding SleepBlocking}"
                                         Visibility="{Binding DataContext.IsSleepBlockingPage,
                                                      RelativeSource={RelativeSource AncestorType=Window},
                                                      Converter={StaticResource BoolVis}}"/>

                <views:SettingsView DataContext="{Binding SettingsPage}"
                                    Visibility="{Binding DataContext.IsSettingsPage,
                                                 RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BoolVis}}"/>
            </Grid>

            <!-- ===================================================== lock screen -->
            <!-- Covers every page once the free trial ends without a purchase.
                 The nav rail stays usable so the user can still look around,
                 but nothing behind this can be operated. -->
            <Border Grid.Row="0" Grid.RowSpan="2" Background="#F2121110"
                    Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}"
                    AutomationProperties.AutomationId="TrialEndedPanel">
                <Border Style="{StaticResource Card}" Padding="32" MaxWidth="520"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="FREE TRIAL ENDED" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Keep FlowShield for $4.99" Style="{StaticResource H1}"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding TrialEndedText}" Style="{StaticResource Body}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   AutomationProperties.AutomationId="TrialEndedText"/>

                        <Button Style="{StaticResource BtnPrimary}" Content="Buy FlowShield — $4.99"
                                Command="{Binding GetProCommand}" Padding="26,12" Margin="0,22,0,0"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="LockBuyButton"
                                AutomationProperties.Name="Buy FlowShield"/>

                        <Border Height="1" Background="{StaticResource Edge}" Margin="0,24,0,18"/>

                        <TextBlock Text="ALREADY BOUGHT IT?" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
                        <TextBox Style="{StaticResource Field}"
                                 Text="{Binding SettingsPage.LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Mono, Consolas, monospace"
                                 AutomationProperties.AutomationId="LockLicenseKeyInput"
                                 AutomationProperties.Name="License key"
                                 AutomationProperties.HelpText="FS-XXXX-XXXX-XXXX-XXXX"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource BtnGhost}" Content="Activate licence"
                                    Command="{Binding SettingsPage.ActivateCommand}"
                                    AutomationProperties.AutomationId="LockActivateButton"
                                    AutomationProperties.Name="Activate licence"/>
                            <TextBlock Text="Checking…" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding SettingsPage.IsBusy, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SettingsPage.LicenseDetailText}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   AutomationProperties.AutomationId="LockLicenseDetailText"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- toast -->
            <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,20" CornerRadius="12" Padding="18,11"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource EdgeBright}" BorderThickness="1"
                    Visibility="{Binding ToastVisible, Converter={StaticResource BoolVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.55"/>
                </Border.Effect>
                <TextBlock Text="{Binding ToastText}" Foreground="{StaticResource Ink}" FontSize="12.5"
                           AutomationProperties.AutomationId="ToastText"/>
            </Border>
        </Grid>
    </Grid>
</Window>
