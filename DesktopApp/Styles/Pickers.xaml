<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <!-- WPF retains date parsing, calendar navigation and automation through
         these stock template parts. Theme.xaml is a sibling dictionary:
         shared styles, fonts, radii and geometries resolve dynamically, too.
         Only styles declared earlier in THIS dictionary use StaticResource. -->

    <Style x:Key="PickerTextBox" TargetType="primitives:DatePickerTextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Primary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimarySoft}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:DatePickerTextBox">
                    <Grid>
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        <!-- A watermark is a hint, not a mouse target or tab stop. -->
                        <ContentControl x:Name="PART_Watermark" IsHitTestVisible="False" IsTabStop="False"
                                        Visibility="Collapsed" VerticalAlignment="Center">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Choose a date" Foreground="{DynamicResource InkFaint}"
                                               FontFamily="{DynamicResource FontStack}" FontSize="13"/>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PickerCalendarButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkDim}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="AutomationProperties.Name" Value="Choose date"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{DynamicResource Surface2}" CornerRadius="{DynamicResource RadiusControl}">
                        <Grid>
                            <Path Style="{DynamicResource IconSmall}" Data="{DynamicResource IconCalendar}"
                                  HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PickerDay" TargetType="primitives:CalendarDayButton">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontStack}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:CalendarDayButton">
                    <Border x:Name="Cell" Background="{DynamicResource Surface}" BorderBrush="{x:Null}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Surface2}"/>
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource PrimarySoft}"/>
                            <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource InkFaint}"/>
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource InkFaint}"/>
                            <Setter Property="TextBlock.TextDecorations" Value="Strikethrough"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource InkFaint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PickerMonth" TargetType="primitives:CalendarButton">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontStack}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="MinWidth" Value="59"/>
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:CalendarButton">
                    <Border x:Name="Cell" Background="{DynamicResource Surface}" BorderBrush="{x:Null}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Surface2}"/>
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource PrimarySoft}"/>
                            <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource InkFaint}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource InkFaint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PickerCalendarItem" TargetType="primitives:CalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:CalendarItem">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static primitives:CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Text="{Binding}" FontFamily="{DynamicResource FontStack}" FontSize="12"
                                       Foreground="{DynamicResource InkFaint}" Margin="0,6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Grid x:Name="PART_Root" KeyboardNavigation.TabNavigation="Once">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PART_PreviousButton" Grid.Column="0" Style="{DynamicResource BtnQuiet}"
                                Width="32" Height="32" Padding="0" AutomationProperties.Name="Previous month">
                            <Path Style="{DynamicResource IconSmall}" Width="6" Height="12"
                                  Data="{DynamicResource IconChevronLeft}"/>
                        </Button>
                        <Button x:Name="PART_HeaderButton" Grid.Column="1" Style="{DynamicResource BtnQuiet}"
                                Height="32" Padding="8,0" FontWeight="Medium" Foreground="{DynamicResource Ink}"/>
                        <Button x:Name="PART_NextButton" Grid.Column="2" Style="{DynamicResource BtnQuiet}"
                                Width="32" Height="32" Padding="0" AutomationProperties.Name="Next month">
                            <Path Style="{DynamicResource IconSmall}" Width="6" Height="12"
                                  Data="{DynamicResource IconChevronRight}"/>
                        </Button>
                        <!-- CalendarItem populates these exact 7x7 and 3x4 grids. -->
                        <Grid x:Name="PART_MonthView" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <Grid x:Name="PART_YearView" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0" Visibility="Hidden">
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_PreviousButton" Property="AutomationProperties.Name" Value="Previous year"/>
                            <Setter TargetName="PART_NextButton" Property="AutomationProperties.Name" Value="Next year"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_PreviousButton" Property="AutomationProperties.Name" Value="Previous decade"/>
                            <Setter TargetName="PART_NextButton" Property="AutomationProperties.Name" Value="Next decade"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Explicitly assigned through DatePicker.CalendarStyle: WPF creates the
         popup Calendar itself and binds its Style to that property. -->
    <Style x:Key="PickerCalendar" TargetType="Calendar">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontStack}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="IsTodayHighlighted" Value="True"/>
        <Setter Property="CalendarItemStyle" Value="{StaticResource PickerCalendarItem}"/>
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource PickerDay}"/>
        <Setter Property="CalendarButtonStyle" Value="{StaticResource PickerMonth}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <!-- Space for the same shadow as Card, including inside Popup. -->
                    <Grid x:Name="PART_Root" Margin="12">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                CornerRadius="{DynamicResource RadiusCard}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45"
                                                  Color="{DynamicResource ShadowColor}"/>
                            </Border.Effect>
                            <primitives:CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"
                                                     FontFamily="{TemplateBinding FontFamily}"
                                                     Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontStack}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="SelectedDateFormat" Value="Short"/>
        <Setter Property="CalendarStyle" Value="{StaticResource PickerCalendar}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="AutomationProperties.HelpText" Value="Enter a date or choose from the calendar"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="PART_Root">
                        <Border x:Name="FieldBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusControl}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <primitives:DatePickerTextBox x:Name="PART_TextBox" Style="{StaticResource PickerTextBox}"
                                                             Margin="12,8,0,8" FontFamily="{TemplateBinding FontFamily}"
                                                             FontSize="{TemplateBinding FontSize}"
                                                             Foreground="{TemplateBinding Foreground}"
                                                             HorizontalContentAlignment="Stretch"/>
                                <Button x:Name="PART_Button" Grid.Column="1" Margin="3"
                                        Style="{StaticResource PickerCalendarButton}"/>
                            </Grid>
                        </Border>
                        <Border x:Name="TextFocusRing" Margin="-4" BorderThickness="2" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource FocusRing}" CornerRadius="{DynamicResource RadiusCard}"
                                Visibility="Collapsed"/>
                        <!-- DatePicker supplies Child and opens/closes this popup. -->
                        <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               PlacementTarget="{Binding ElementName=PART_Root}" HorizontalOffset="-12" VerticalOffset="-8"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource EdgeBright}"/>
                        </Trigger>
                        <Trigger SourceName="PART_TextBox" Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                            <Setter TargetName="TextFocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
