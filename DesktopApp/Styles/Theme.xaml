<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:inf="clr-namespace:FlowShield.Infrastructure"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================ palette
         Every colour comes from Tokens.xaml, generated from design/tokens.json by
         tools/build_tokens.py. Change colours there, never here.

         Tokens.xaml and ShieldGlyphs.xaml are merged by App.xaml, ahead of this
         file, not here: F21 swaps the tokens dictionary at run time, and a merge
         from inside this file would shadow the swapped one and pin the app to
         dark. Colour references below are DynamicResource for the same reason. -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ================================================================ shape
         DESIGN_SYSTEM.md §4 corner-radius scale, defined once here per the
         doc amendment (UI-SPEC.md §1.7.1): "Spacing and corner-radius
         values are defined as resources in DesktopApp/Styles/Theme.xaml
         (app) and directly in Website/styles.css (site) — not in
         design/tokens.json, which is colour only (§14)." Every CornerRadius
         in the app draws from one of these three, or is fully round (A2, #147).
         The November 2026 redesign (#430) set surfaces 12 and controls 8
         (design/redesign-2026-11/README.md, "Corner radius"):
           6  — small chips/tags (TagChip)
           8  — buttons, inputs, toggles, and interactive rows/icon badges
           12 — cards, dialogs, and other surfaces (toast, flyouts, focus ring)
           fully round — pills, the tier badge, toggle tracks, the nav bar
                and scrollbar thumb, progress bars. NOT a huge radius: WPF
                doesn't clamp an oversized CornerRadius the way CSS does, it
                scales the curves, so 9999 drew ellipses and spikes. Set
                inf:Pill.IsRound="True" instead; it keeps the radius at half
                the element's smaller side (Infrastructure/Pill.cs). -->
    <CornerRadius x:Key="RadiusChip">6</CornerRadius>
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>

    <!-- The widest a page's content gets, margins aside (#406). Past it, the
         page sits centred beside the rail rather than spreading its cards
         across an ultrawide screen. -->
    <sys:Double x:Key="PageMaxWidth">1280</sys:Double>

    <!-- Spacing scale, DESIGN_SYSTEM.md §4: 4, 8, 12, 16, 24, 32, 48, 64.
         Page margins 32, card padding 24 (CardPadding above via the Card
         style's own Padding setter), gap between cards 16, nav rail 240.
         The rail width and page margins are literals at their one call
         site in MainWindow.xaml rather than resources here: GridLength and
         Thickness properties don't accept a bare numeric StaticResource
         without a type-converter round-trip that XAML doesn't perform for
         resource references (only for literal string content), so a named
         resource here would just be an extra indirection to the same
         number. Every other Padding/Margin in the app is a literal drawn
         from this same eight-number scale, hand-applied per element —
         matching how the site implements the identical scale directly in
         styles.css (see the doc amendment above). -->

    <!-- ========================================================= converters -->

    <inf:InverseBooleanConverter x:Key="InvBool"/>
    <inf:BoolToVisibilityConverter x:Key="BoolVis"/>
    <inf:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
    <inf:EnumEqualsConverter x:Key="EnumEq"/>
    <inf:IntEqualsConverter x:Key="IntEq"/>
    <inf:BoolToOpacityConverter x:Key="BoolOpacity"/>
    <inf:InitialConverter x:Key="Initial"/>
    <inf:BlockedAppIconConverter x:Key="BlockedAppIcon"/>
    <inf:ShieldRomanConverter x:Key="ShieldRoman"/>
    <!-- Radius 105 = (222 - 12) / 2: the A4 ring is 222px in diameter with a
         12px stroke (UI-SPEC.md §1.7.2 doc amendment), and the dash array is
         computed off the stroke's own centreline, not the outer box. -->
    <inf:ProgressToDashConverter x:Key="ProgressDash" Radius="105" Thickness="12"/>
    <inf:PositiveToVisibilityConverter x:Key="PositiveVis"/>
    <inf:ProgressToArcConverter x:Key="ProgressArc" Radius="105" Centre="111"/>
    <inf:TrendGeometryConverter x:Key="TrendGeometry" Width="250" Height="64"/>
    <inf:AppNamesConverter x:Key="AppNames"/>
    <inf:AppNamesRefreshingConverter x:Key="AppNamesRefreshing"/>
    <inf:NonEmptyToVisibilityConverter x:Key="NonEmptyVis"/>
    <inf:ShieldLevelToGlyphConverter x:Key="ShieldGlyph"/>
    <inf:ResourceKeyToBrushConverter x:Key="ResourceKeyToBrush"/>
    <!-- History's heatmap (F16): five steps mixed from surface-2 to primary. -->
    <inf:HeatStepToBrushConverter x:Key="HeatStep" Steps="5"/>
    <inf:AppsOnShieldLabelConverter x:Key="AppsOnShieldLabel"/>
    <inf:HorizontalPaddingConverter x:Key="HorizontalPadding"/>

    <!-- ======================================================== focus ring
         DESIGN_SYSTEM.md §13: "Every interactive element is reachable and
         usable from the keyboard, with a visible 2 px focus ring."

         WPF's own focus visual is a 1px dotted rectangle that all but vanishes
         on these surfaces, so every interactive style below sets this one
         instead: a 2px focus-ring outline, offset 2px so it reads as a ring
         around the control rather than a border on it. It is drawn in the
         adorner layer, above whatever the control is sitting on.

         FocusVisualStyle only draws for *keyboard* focus, which is what §13
         asks for — clicking a button does not make it sprout a ring. Controls
         that also change their own template on IsKeyboardFocused (buttons, the
         text field, heatmap cells) keep doing so; this makes the rest of the
         app match them. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" StrokeThickness="2" RadiusX="11" RadiusY="11"
                               Stroke="{DynamicResource FocusRing}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================= typography -->

    <!-- A FontFamily resource (not a string): a StaticResource reference does not
         run type converters, so a string here fails to coerce at runtime.

         Segoe UI Variable, the Windows 11 system face (DESIGN_SYSTEM.md Part A,
         Type and icons; #430), so the window's own title bar and the app's
         content are one typeface. Nothing is bundled.

         Engineering fact, measured on Windows 11 build 26300: WPF resolves
         "Segoe UI Variable Text" and "Segoe UI Variable Display" to
         SEGUIVAR.TTF, but the bare "Segoe UI Variable" to SEGOEUI.TTF, plain
         Segoe UI. So each stack names its optical cut. On Windows 10, which
         has no Segoe UI Variable, both fall back to Segoe UI.

         FontStack (Text) is for everything people read at text sizes;
         FontStackDisplay is for the countdown, the big numbers and page
         titles. -->
    <FontFamily x:Key="FontStack">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontStackDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Implicit default (no x:Key): any TextBlock that doesn't set its own
         Style still renders in Segoe UI Variable Text rather than WPF's own
         default. The named styles below also set FontFamily explicitly, so
         each reads correctly on its own. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontStack}"/>
    </Style>

    <!-- Text scale, DESIGN_SYSTEM.md §3. Tracking is approximated through
         weight and size, per the doc's own WPF column — TextBlock has no
         letter-spacing property on net10.0-windows (see the Eyebrow style
         below for what was tried and why it doesn't build). -->

    <!-- display: page titles, lock screen, section headings. The Display cut. -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontStackDisplay}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="36"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>

    <!-- title: card titles, dialog titles -->
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontStack}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>

    <!-- body: paragraphs, list items (14/21 in the app; the site uses 17/27) -->
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontStack}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="LineHeight" Value="21"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource InkDim}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- label: buttons, field labels -->
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>

    <!-- caption: hints, timestamps -->
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="17"/>
        <Setter Property="Foreground" Value="{DynamicResource InkFaint}"/>
    </Style>

    <!-- eyebrow: section labels such as "MOMENTUM". Text is authored in caps
         already (there's no WPF text-transform). §3's WPF column suggests
         TextBlock.CharacterSpacing for the +6% tracking, but that property
         was never ported from .NET Framework to .NET (Core) WPF — it does
         not exist on net8.0 or net10.0-windows (confirmed: not in PresentationFramework
         or PresentationCore, and MC4005 at build time). Tracking here is
         weight + size only, as the doc's own fallback rule allows. -->
    <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="LineHeight" Value="14"/>
    </Style>

    <!-- A card's own title, in sentence case (#431): "Now", "Up next",
         "Momentum", "Templates". Smaller than H2, since a card title labels a
         surface rather than heading a page section. -->
    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <!-- A label above a control, in sentence case (#431 replaced the upper-case
         eyebrows on Today): "Shield level", "Your plan (optional)". -->
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- The end of a sprint's headline: "15 minutes focused". The Display cut,
         like the countdown it stands in for. -->
    <Style x:Key="ResultTitle" TargetType="TextBlock" BasedOn="{StaticResource H1}">
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="LineHeight" Value="42"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- F22: header for each of Settings' six labelled groups. Focusable so
         Task 2's section rail's JumpTo can scroll to the group's offset and
         focus this header. -->
    <Style x:Key="SettingsGroupHeader" TargetType="TextBlock" BasedOn="{StaticResource H2}">
        <Setter Property="Margin" Value="0,32,0,12"/>
        <Setter Property="Focusable" Value="True"/>
    </Style>

    <!-- timer: the sprint countdown. Tabular by default so the digits never
         jiggle. §3's WPF column suggests CharacterSpacing="-20" here too;
         see the Eyebrow comment above for why that isn't available on this
         platform. Wired into TodayView's 222px ring (A4, UI-SPEC.md §1.7.2),
         in the Display cut (Part A: Display for the countdown). -->
    <Style x:Key="Timer" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontStackDisplay}"/>
        <Setter Property="FontSize" Value="64"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="64"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- stat: momentum, minutes, prices. Tabular by default. Wired into
         TodayView's momentum number (A4). -->
    <Style x:Key="Stat" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontStackDisplay}"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="40"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- ===================================================== surfaces (depth)
         DESIGN_SYSTEM.md Part A, Depth, and design/redesign-2026-11/README.md's
         depth table (#430). The window is E0 (Mica, or its solid fallback; see
         MainWindow's backdrop). Surfaces sit above it at:

           E1 resting  Card         sidebar, side cards, lists
           E2 raised   CardRaised   the thing you act on now (Today's Now)
           E3 flyout   Flyout       setup panel, dropdowns, menus, calendars

         Each is its elevation colour with a 1 px top highlight (painted into
         the background brush by tools/build_tokens.py, since WPF has no inset
         shadow), a 1 px hairline, and a black shadow that falls straight down
         and grows with height. All three are generated per theme into the
         Tokens dictionaries, so they swap with it. -->

    <!-- The main window's background while Mica shows through it
         (Services/WindowBackdrop.cs). Not a colour: the absence of one. -->
    <SolidColorBrush x:Key="BackdropClear" Color="Transparent"/>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Elev1Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Effect" Value="{DynamicResource ShadowE1}"/>
    </Style>

    <Style x:Key="CardRaised" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource Elev2Surface}"/>
        <Setter Property="Effect" Value="{DynamicResource ShadowE2}"/>
    </Style>

    <!-- E3. Acrylic is not built yet: this is the solid E3 the spec names as
         acrylic's fallback, which is also what every text pair is measured on. -->
    <Style x:Key="Flyout" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource Elev3Surface}"/>
        <Setter Property="Effect" Value="{DynamicResource ShadowE3}"/>
    </Style>

    <!-- A card tinted with primary-soft: the schedule heads-up on Today and
         the sleep page's trial-ended notice (#347). primary-soft is
         translucent, and a DropShadowEffect is drawn from the alpha of
         everything inside the element, so a Card with that background cast a
         blurred shadow from every line of text and both buttons through it.
         Here the shadow sits on an opaque surface layer and the tint is
         painted inside it, so only the card's outline casts one. -->
    <Style x:Key="CardTinted" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{DynamicResource Elev1Surface}" BorderBrush="{DynamicResource Primary}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusCard}"
                            Effect="{DynamicResource ShadowE1}">
                        <Border Background="{DynamicResource PrimarySoft}" CornerRadius="{StaticResource RadiusCard}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="inf:Pill.IsRound" Value="True"/>
        <Setter Property="Padding" Value="12,4"/>
    </Style>

    <!-- Category tag chip (UI-SPEC.md A3, graft from raycast's app-pages
         sketch): the 6px small-chip radius, next to an app name or picker
         candidate ("Chat", "Music" …). Text-only, so a TextBlock using it
         sets its own Style="{StaticResource Caption}" inside. -->
    <Style x:Key="TagChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- ============================================================ buttons

         Raised controls (DESIGN_SYSTEM.md Part A, Depth; #430): a button sits
         a step above its surface, so it has the control fill, a lit top edge
         (ControlHighlight), a 1 px edge and a 1 px shadow straight down
         (ControlShadow). Height 40, radius 8 (RadiusControl).

         The shadow is a 1 px line under the bottom edge rather than a full
         rectangle behind the button: the control fill is translucent, and a
         rectangle behind it would darken the whole face.

         States: hover lifts the fill (ControlHover), pressed drops it
         (ControlPressed) and hides the lit edge, disabled is 45% opacity with
         no hover, and keyboard focus shows the 2 px focus ring offset 2 px.
         BtnGhost and BtnDanger use this template unchanged. -->

    <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontStack}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="{DynamicResource Control}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="under" VerticalAlignment="Bottom" Height="1" Margin="4,0,4,-1"
                                Background="{DynamicResource ControlShadow}" IsHitTestVisible="False"/>
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusControl}">
                            <Grid>
                                <Border x:Name="lit" BorderBrush="{DynamicResource ControlHighlight}"
                                        BorderThickness="0,1,0,0" CornerRadius="{StaticResource RadiusControl}"
                                        IsHitTestVisible="False"/>
                                <ContentPresenter Margin="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HorizontalPadding}}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border x:Name="focus" BorderBrush="{DynamicResource FocusRing}" BorderThickness="2"
                                CornerRadius="{StaticResource RadiusCard}" Margin="-4" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlPressed}"/>
                            <Setter TargetName="lit" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="under" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focus" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            <Setter TargetName="under" Property="Visibility" Value="Hidden"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary: one of the four places a gradient is allowed (Part A, Depth).
         The PrimaryGradient fill (lighter at the top), a lit top edge
         (PrimaryHighlight), a fine dark edge, and a two-part shadow straight
         down: a 1 px PrimaryShadow line and the soft ShadowPrimary below it.
         The face is opaque, so the shadow layer can sit behind all of it.
         primary-ink on either gradient stop measures at least 4.85:1 (§2).
         Hover brightens the face with a thin PrimaryHighlight wash; pressed
         darkens it with PrimaryEdge. -->
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{DynamicResource PrimaryGradient}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryEdge}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryInk}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="shadow" Margin="0,1,0,-1" CornerRadius="{StaticResource RadiusControl}"
                                Background="{DynamicResource PrimaryShadow}" Effect="{DynamicResource ShadowPrimary}"
                                IsHitTestVisible="False"/>
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusControl}">
                            <Grid>
                                <Border x:Name="wash" Background="{DynamicResource PrimaryHighlight}" Opacity="0"
                                        CornerRadius="{StaticResource RadiusControl}" IsHitTestVisible="False"/>
                                <Border x:Name="lit" BorderBrush="{DynamicResource PrimaryHighlight}"
                                        BorderThickness="0,1,0,0" CornerRadius="{StaticResource RadiusControl}"
                                        IsHitTestVisible="False"/>
                                <ContentPresenter Margin="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HorizontalPadding}}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border x:Name="focus" BorderBrush="{DynamicResource FocusRing}" BorderThickness="2"
                                CornerRadius="{StaticResource RadiusCard}" Margin="-4" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="wash" Property="Opacity" Value="0.4"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="wash" Property="Background" Value="{DynamicResource PrimaryEdge}"/>
                            <Setter TargetName="wash" Property="Opacity" Value="1"/>
                            <Setter TargetName="lit" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focus" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            <Setter TargetName="shadow" Property="Visibility" Value="Hidden"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary: the raised control exactly as BtnBase draws it. Kept as its
         own key because 21 call sites use it. -->
    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}"/>

    <!-- Destructive (§7): the raised control with a danger label and edge. Use
         wherever the app removes something the user added (e.g. "Remove" on a
         blocked app row). -->
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="BorderBrush" Value="{DynamicResource Rose}"/>
        <Setter Property="Foreground" Value="{DynamicResource Rose}"/>
    </Style>

    <!-- Quiet: no fill, text-muted label, the control fill on hover (§7). Not
         raised, so it has its own flat template. -->
    <Style x:Key="BtnQuiet" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource InkDim}"/>
        <!-- 12, not BtnBase's 20: a quiet button reads as text until hovered,
             so one at the start of a line takes Margin="-12,…" and its label
             lines up with the text above it (#406; with 20 it sat 8 px in). -->
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusControl}"
                                Padding="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HorizontalPadding}}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="focus" BorderBrush="{DynamicResource FocusRing}" BorderThickness="2"
                                CornerRadius="{StaticResource RadiusCard}" Margin="-4" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Control}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlPressed}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focus" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Link: going to another place or to help, and nothing else (Part A,
         Information hierarchy): "Edit schedules", "How momentum works". The
         label in primary (5.0:1 or better on E1 and E2, section 2) with a
         small chevron, no fill; the control fill on hover. From the Today
         redesign (#431). -->
    <Style x:Key="BtnLink" TargetType="Button" BasedOn="{StaticResource BtnQuiet}">
        <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource RadiusChip}"
                                Padding="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HorizontalPadding}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center"/>
                                <!-- A drawn chevron: the icon font's glyph sits low beside text. -->
                                <Path Data="M0,0 L3.5,3.5 L0,7" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Margin="8,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="focus" BorderBrush="{DynamicResource FocusRing}" BorderThickness="2"
                                CornerRadius="{StaticResource RadiusControl}" Margin="-3" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Control}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlPressed}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focus" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A template card on Today (#431): the whole card is a button that fills
         the template in (a preset, not a lock, F6), drawn as a row of the
         raised control material. Its Start button sits on top of it, beside
         it in the tree rather than inside it. -->
    <sys:Double x:Key="TemplateCardHeight">56</sys:Double>
    <Style x:Key="TemplateCard" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <!-- Dynamic, so Today's short-page density can lower it (#431). -->
        <Setter Property="Height" Value="{DynamicResource TemplateCardHeight}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" Background="{DynamicResource Control}" BorderBrush="{DynamicResource ControlEdge}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusControl}">
                            <Grid>
                                <Border x:Name="lit" BorderBrush="{DynamicResource ControlHighlight}" BorderThickness="0,1,0,0"
                                        CornerRadius="{StaticResource RadiusControl}" IsHitTestVisible="False"/>
                                <ContentPresenter Margin="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HorizontalPadding}}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border x:Name="focus" BorderBrush="{DynamicResource FocusRing}" BorderThickness="2"
                                CornerRadius="{StaticResource RadiusCard}" Margin="-4" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlPressed}"/>
                            <Setter TargetName="lit" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focus" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An icon-only button, such as a panel's Close: square, raised. Give it
         an AutomationProperties.Name, since its content is a glyph. -->
    <Style x:Key="BtnIcon" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- ========================================================== nav items -->

    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource InkDim}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <!-- BtnBase fixes Height=40; with 12px vertical padding that left a
             16px box for a 20px icon, clipping it top and bottom (#189). -->
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- The selected item is raised to E2 (Part A, Depth): its surface
                     with the top highlight and a hairline, plus the teal bar, so
                     selection never rests on the fill's tone alone. The hairline
                     is always there, transparent, so selecting moves nothing. -->
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusControl}"
                                BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Margin="0,11"
                                inf:Pill.IsRound="True" Background="{DynamicResource Primary}" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Control}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Elev2Surface}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Hairline}"/>
                            <Setter TargetName="bar" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================== settings rail -->

    <!-- F22: the Settings section rail. Same hover/focus tokens as NavButton
         above (Control hover, InkDim -> Ink text) but a left bar rather than
         the main nav's, and driven by IsChecked (it's a RadioButton) rather
         than a Tag DataTrigger, since the rail tracks scroll position, not a
         command binding. NavButton uses Primary for its bar/selected accent
         since this app has no "Accent" token — this style follows suit. -->
    <Style x:Key="SettingsNavLink" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource InkDim}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontStack}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- Drawn like the main rail's NavButton (#406): the raised E2
                     item and a pill-shaped Primary bar, so the two rails mark
                     "you are here" the same way. -->
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusControl}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="bar" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                Margin="0,8" inf:Pill.IsRound="True" Background="{DynamicResource Primary}"
                                Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Control}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Elev2Surface}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Hairline}"/>
                            <Setter TargetName="bar" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <!-- F22: on narrow windows the rail's WrapPanel switches to
                             Orientation="Horizontal" (chip row) — the selected
                             indicator becomes a 2px bar under the label instead of
                             the 3px left bar, so it still reads as an underline in a
                             row rather than a stray left tick. Bold weight plus the
                             bar carries the selected state; colour is never the only
                             signal. -->
                        <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource
                                     FindAncestor, AncestorType=WrapPanel}}" Value="Horizontal">
                            <Setter TargetName="bar" Property="Width" Value="NaN"/>
                            <Setter TargetName="bar" Property="Height" Value="2"/>
                            <Setter TargetName="bar" Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter TargetName="bar" Property="VerticalAlignment" Value="Bottom"/>
                            <Setter TargetName="bar" Property="Margin" Value="12,0"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================= inputs -->

    <!-- Text field: recessed (Part A, Depth; #430). A well a step below its
         surface, with a fine edge and the Windows bottom line (WellLine), which
         turns Primary and 2 px thick on keyboard focus, as Windows' own fields
         do. The focus ring is drawn as well, for the 2 px ring rule. -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontStack}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Primary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimarySoft}"/>
        <Setter Property="Background" Value="{DynamicResource Well}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WellEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid x:Name="root">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusControl}">
                        <Grid Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                            <!-- An empty field shows its HelpText as a faint
                                 placeholder, so no box on screen is blank with no
                                 hint of what goes in it (#406). text-faint on the
                                 well over E2 measures 5.41:1 dark, 6.11:1 light
                                 (§2). The 2 px lines it up with the text's own
                                 inset. -->
                            <TextBlock x:Name="hint" Margin="2,0,0,0" IsHitTestVisible="False"
                                       Visibility="Collapsed" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource InkFaint}"
                                       Text="{Binding (AutomationProperties.HelpText),
                                              RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Grid>
                    </Border>
                    <Border x:Name="line" BorderBrush="{DynamicResource WellLine}" BorderThickness="0,0,0,1"
                            CornerRadius="{StaticResource RadiusControl}" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="line" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                            <Setter TargetName="line" Property="BorderThickness" Value="0,0,0,2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity"
                                                          To="0.45" Duration="{x:Static inf:Motion.Selection}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity"
                                                          To="1" Duration="{x:Static inf:Motion.Selection}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch, built from a CheckBox so it keeps the Toggle pattern
         that UI Automation (and the test suite) expects. Redesign (#430): a
         40 x 20 recessed track with a WellLine edge and a small InkDim knob
         when off; when on, one of Part A's four gradients (PrimaryGradient)
         with a larger PrimaryInk knob at the right. The knob's side says the
         state as well as the colour does. -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontStack}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Grid Grid.Column="1" Width="40" Height="20" VerticalAlignment="Center">
                            <Border x:Name="track" inf:Pill.IsRound="True" Background="{DynamicResource Well}"
                                    BorderBrush="{DynamicResource WellLine}" BorderThickness="1"/>
                            <Ellipse x:Name="knob" Width="12" Height="12" Fill="{DynamicResource InkDim}"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource PrimaryGradient}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource PrimaryEdge}"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Width" Value="14"/>
                            <Setter TargetName="knob" Property="Height" Value="14"/>
                            <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource PrimaryInk}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="knob" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same switch with its state written beside it ("On" / "Off"), so
         it never relies on colour or knob position alone (Plans' schedules,
         design/redesign-2026-11/README.md). The words are drawn, not named:
         UI Automation already reports the CheckBox's toggle state. -->
    <Style x:Key="SwitchStated" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="content" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Grid Grid.Column="1" Width="40" Height="20" VerticalAlignment="Center">
                            <Border x:Name="track" inf:Pill.IsRound="True" Background="{DynamicResource Well}"
                                    BorderBrush="{DynamicResource WellLine}" BorderThickness="1"/>
                            <Ellipse x:Name="knob" Width="12" Height="12" Fill="{DynamicResource InkDim}"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Grid>
                        <TextBlock x:Name="state" Grid.Column="2" Text="Off" MinWidth="24" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontFamily="{StaticResource FontStack}"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource PrimaryGradient}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource PrimaryEdge}"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Width" Value="14"/>
                            <Setter TargetName="knob" Property="Height" Value="14"/>
                            <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource PrimaryInk}"/>
                            <Setter TargetName="state" Property="Text" Value="On"/>
                        </Trigger>
                        <!-- No label (Plans' rows put theirs beside it): no gap before the track. -->
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="content" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="knob" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented option (sprint length, shield level, daily goal, theme…).
         Redesign (#430): an option you could pick is recessed (the well), and
         the picked one is raised: the Thumb fill, a lit top edge, and the same
         teal marker as the sidebar, so selection never rests on tone alone.
         These sit loose in a row on today's screens; SegmentGroup and
         SegmentItem below are the grouped selector of the mockups, for the
         screens that adopt it. Motion, §8: checking settles in over
         Motion.Selection (200ms, ease-out); a disabled group fades to 45% the
         same way, and back. -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource FontStack}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource InkDim}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="root">
                        <Border x:Name="bd" Background="{DynamicResource SegmentTrack}" BorderBrush="{DynamicResource WellEdge}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="lit" BorderBrush="{DynamicResource ControlHighlight}" BorderThickness="0,1,0,0"
                                CornerRadius="{StaticResource RadiusControl}" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="marker" Width="16" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="0,0,0,3" inf:Pill.IsRound="True" Background="{DynamicResource Primary}"
                                Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource EdgeBright}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Thumb}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ControlEdge}"/>
                            <Setter TargetName="lit" Property="Opacity" Value="1"/>
                            <Setter TargetName="marker" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Opacity"
                                                          From="0.7" To="1" Duration="{x:Static inf:Motion.Selection}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity"
                                                          To="0.45" Duration="{x:Static inf:Motion.Selection}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity"
                                                          To="1" Duration="{x:Static inf:Motion.Selection}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A pick-one choice with a title and a line or two of explanation, such
         as first-run's shield levels: the Segment look as a full-width row
         (#406), with the teal marker at its left edge as in the sidebar. -->
    <Style x:Key="OptionCard" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="root">
                        <Border x:Name="bd" Background="{DynamicResource SegmentTrack}" BorderBrush="{DynamicResource WellEdge}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="lit" BorderBrush="{DynamicResource ControlHighlight}" BorderThickness="0,1,0,0"
                                CornerRadius="{StaticResource RadiusControl}" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="marker" Width="3" HorizontalAlignment="Left" Margin="0,12"
                                inf:Pill.IsRound="True" Background="{DynamicResource Primary}"
                                Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource EdgeBright}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Thumb}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ControlEdge}"/>
                            <Setter TargetName="lit" Property="Opacity" Value="1"/>
                            <Setter TargetName="marker" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Opacity"
                                                          From="0.7" To="1" Duration="{x:Static inf:Motion.Selection}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity"
                                                          To="0.45" Duration="{x:Static inf:Motion.Selection}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity"
                                                          To="1" Duration="{x:Static inf:Motion.Selection}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The same chip for a choice of several (F6's day chips): a CheckBox, so
         it keeps the Toggle pattern, drawn exactly like Segment above. -->
    <Style x:Key="SegmentCheck" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource FontStack}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource InkDim}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="root">
                        <Border x:Name="bd" Background="{DynamicResource SegmentTrack}" BorderBrush="{DynamicResource WellEdge}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="lit" BorderBrush="{DynamicResource ControlHighlight}" BorderThickness="0,1,0,0"
                                CornerRadius="{StaticResource RadiusControl}" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="marker" Width="16" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="0,0,0,3" inf:Pill.IsRound="True" Background="{DynamicResource Primary}"
                                Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource EdgeBright}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Thumb}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ControlEdge}"/>
                            <Setter TargetName="lit" Property="Opacity" Value="1"/>
                            <Setter TargetName="marker" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Opacity"
                                                          From="0.7" To="1" Duration="{x:Static inf:Motion.Selection}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity"
                                                          To="0.45" Duration="{x:Static inf:Motion.Selection}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity"
                                                          To="1" Duration="{x:Static inf:Motion.Selection}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Shield-level chip (UI-SPEC.md A4): the same segmented cell as
         Segment above, tall enough (52px) for the shared shield glyph
         stacked above its label. -->
    <Style x:Key="SegmentShield" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource FontStack}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkDim}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="root">
                        <Border x:Name="bd" Background="{DynamicResource SegmentTrack}" BorderBrush="{DynamicResource WellEdge}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="8,8" Height="52">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="lit" BorderBrush="{DynamicResource ControlHighlight}" BorderThickness="0,1,0,0"
                                CornerRadius="{StaticResource RadiusControl}" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="marker" Width="16" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="0,0,0,3" inf:Pill.IsRound="True" Background="{DynamicResource Primary}"
                                Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource EdgeBright}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Thumb}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ControlEdge}"/>
                            <Setter TargetName="lit" Property="Opacity" Value="1"/>
                            <Setter TargetName="marker" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Opacity"
                                                          From="0.7" To="1" Duration="{x:Static inf:Motion.Selection}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity"
                                                          To="0.45" Duration="{x:Static inf:Motion.Selection}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity"
                                                          To="1" Duration="{x:Static inf:Motion.Selection}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The grouped segmented selector of the mockups (#430): a recessed track
         holding SegmentItem options, of which the picked one is the raised
         thumb with the teal marker. Put the items in a horizontal StackPanel
         or UniformGrid inside a Border with this style. (Not "SegmentTrack":
         that key is the track's colour token, and a style of the same name
         here would shadow it.) -->
    <Style x:Key="SegmentGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SegmentTrack}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WellEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="SegmentItem" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource FontStack}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource InkDim}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="root">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusChip}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="lit" BorderBrush="{DynamicResource ControlHighlight}" BorderThickness="0,1,0,0"
                                CornerRadius="{StaticResource RadiusChip}" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="marker" Width="16" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="0,0,0,3" inf:Pill.IsRound="True" Background="{DynamicResource Primary}"
                                Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Control}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Thumb}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ControlEdge}"/>
                            <Setter TargetName="lit" Property="Opacity" Value="1"/>
                            <Setter TargetName="marker" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Opacity"
                                                          From="0.7" To="1" Duration="{x:Static inf:Motion.Selection}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity"
                                                          To="0.45" Duration="{x:Static inf:Motion.Selection}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity"
                                                          To="1" Duration="{x:Static inf:Motion.Selection}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Disclosure: shows more in place (Part A, Information hierarchy), such
         as a running sprint's Details. A raised button whose chevron turns to
         point up while open. A ToggleButton, so UI Automation reports open and
         closed; bind IsChecked to what it shows. The chevron turns without
         animation, which also honours reduced motion. -->
    <Style x:Key="Disclosure" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource FontStack}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="{DynamicResource Control}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="16,0,12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="under" VerticalAlignment="Bottom" Height="1" Margin="4,0,4,-1"
                                Background="{DynamicResource ControlShadow}" IsHitTestVisible="False"/>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusControl}">
                            <Grid>
                                <Border x:Name="lit" BorderBrush="{DynamicResource ControlHighlight}" BorderThickness="0,1,0,0"
                                        CornerRadius="{StaticResource RadiusControl}" IsHitTestVisible="False"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HorizontalPadding}}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                    <TextBlock x:Name="chevron" Style="{StaticResource IconSmall}" FontSize="12"
                                               Text="{StaticResource IconChevronDown}" Margin="8,0,0,0"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="focus" BorderBrush="{DynamicResource FocusRing}" BorderThickness="2"
                                CornerRadius="{StaticResource RadiusCard}" Margin="-4" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlPressed}"/>
                            <Setter TargetName="lit" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="under" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focus" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            <Setter TargetName="under" Property="Visibility" Value="Hidden"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dropdown (a ComboBox), such as the setup panel's blocklist: the
         recessed well with the Windows bottom line and a chevron, opening an
         E3 flyout. The flyout is solid E3 (acrylic's fallback) until acrylic
         is built. -->
    <Style x:Key="DropdownToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="bd" Background="{DynamicResource Well}" BorderBrush="{DynamicResource WellEdge}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusControl}"/>
                        <Border x:Name="line" BorderBrush="{DynamicResource WellLine}" BorderThickness="0,0,0,1"
                                CornerRadius="{StaticResource RadiusControl}"/>
                        <TextBlock Style="{StaticResource IconSmall}" FontSize="12" Text="{StaticResource IconChevronDown}"
                                   HorizontalAlignment="Right" Margin="0,0,12,0" Foreground="{DynamicResource InkDim}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource EdgeBright}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="line" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                            <Setter TargetName="line" Property="BorderThickness" Value="0,0,0,2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dropdown" TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontStack}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="ItemContainerStyle" Value="{DynamicResource DropdownItem}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="root">
                        <ToggleButton x:Name="toggle" Style="{StaticResource DropdownToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="12,0,36,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               PopupAnimation="None" HorizontalOffset="-16" VerticalOffset="-4"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <!-- Room for the E3 shadow, which falls straight down. -->
                            <Grid Margin="16,8,16,40">
                                <Border Style="{StaticResource Flyout}" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DropdownItem" TargetType="ComboBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource RadiusChip}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <Border x:Name="marker" Width="3" HorizontalAlignment="Left" Margin="0,10"
                                inf:Pill.IsRound="True" Background="{DynamicResource Primary}" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="marker" Property="Opacity" Value="1"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain radio buttons and check boxes — the daily-goal and export-format
         choices, the first-run app list — keep WPF's own template but take the
         same 2px focus ring as everything else (§13). Keyed styles above are
         unaffected: an explicit Style replaces the implicit one outright, which
         is why Segment, SegmentShield and Switch each set it themselves. -->
    <Style TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontStack}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontStack}"/>
    </Style>

    <!-- ========================================================= scrollbars -->

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="9"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <!-- Margin stays 2px, off the 4-based scale: the scrollbar
                                                 itself is a fixed 9px chrome element (Width above), and
                                                 a 4px inset each side would leave only 1px of visible
                                                 thumb. Noted as a deliberate exception in the A2 PR. -->
                                            <Border Background="{DynamicResource EdgeBright}" inf:Pill.IsRound="True" Margin="2,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================== list rows -->

    <!-- A row on a card: the raised control material, like the mockups'
         template and app tiles, so it reads as something to act on. -->
    <!-- An app on a blocklist's row on Plans (#433): the app's own icon and
         its name on a raised face, the same fill, edge and 8 px radius as a
         button so the row reads as a set of things you put there. Not a
         button itself: Edit and Add an app are the row's actions. -->
    <Style x:Key="AppChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Control}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="7,0,14,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- One of several named things, picked with a radio (Plans' blocklists,
         #433): an 18 px recessed ring, filled with the primary dot when picked,
         and its label beside it. The label carries the meaning, so the choice
         never rests on the dot alone. -->
    <Style x:Key="ChoiceRadio" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontStack}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="mark" Width="18" Height="18" Margin="0,1,10,0" VerticalAlignment="Top">
                            <Ellipse Fill="{DynamicResource Well}" Stroke="{DynamicResource WellLine}" StrokeThickness="1"/>
                            <Ellipse x:Name="dot" Width="8" Height="8" Fill="{DynamicResource Primary}" Opacity="0"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot" Property="Opacity" Value="1"/>
                        </Trigger>
                        <!-- Tag False: only one choice exists, so no ring is drawn. -->
                        <Trigger Property="Tag">
                            <Trigger.Value><sys:Boolean>False</sys:Boolean></Trigger.Value>
                            <Setter TargetName="mark" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="mark" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RowCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Control}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style TargetType="ListBoxItem" x:Key="PlainItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================= heatmap cell (History, F16)
         DESIGN_SYSTEM.md §7 asks that a heatmap never rely on colour alone and
         that "hovering or focusing a cell shows the value". A Border or a
         Rectangle can do neither: it takes no focus, and UI Automation does not
         surface it, so a screen reader would be handed 30 coloured shapes with
         nothing to say about them. A ListBoxItem is a real control — it takes
         keyboard focus, it carries the day and its minutes as its accessible
         name, and it shows the same line as a tooltip on hover. -->
    <Style x:Key="HeatCellItem" TargetType="ListBoxItem" BasedOn="{StaticResource PlainItem}">
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        <Setter Property="ToolTip" Value="{Binding Name}"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <!-- 24 px since #434, so History's summary fits three parts
                         abreast on a laptop-sized window. -->
                    <Border x:Name="Cell" Width="24" Height="24" Margin="0,0,4,4"
                            CornerRadius="{StaticResource RadiusChip}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Edge}"
                            Background="{Binding Step, Converter={StaticResource HeatStep}}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Cell" Property="BorderBrush"
                                    Value="{DynamicResource FocusRing}"/>
                            <Setter TargetName="Cell" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cell" Property="BorderBrush"
                                    Value="{DynamicResource EdgeBright}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The legend's five swatches. Not focusable and not named: the legend is
         decoration beside the "Less"/"More" captions, which say what it means. -->
    <Style x:Key="HeatLegendItem" TargetType="ListBoxItem" BasedOn="{StaticResource PlainItem}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Width="14" Height="14" Margin="0,0,4,0"
                            CornerRadius="{StaticResource RadiusChip}"
                            BorderThickness="1" BorderBrush="{DynamicResource Edge}"
                            Background="{Binding Converter={StaticResource HeatStep}}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PickerItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkDim}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontStack}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource RadiusControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Control}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimarySoft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================== daily goal bar -->

    <!-- A thin track that fills as the day's goal is met (F15). The default
         WPF ProgressBar template carries a gloss overlay and animated flare
         that belong to a different decade; this is a rounded track and fill,
         and nothing else. Turns green once the goal is met, so the state is
         not carried by width alone. -->
    <Style x:Key="GoalBar" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Track}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border inf:Pill.IsRound="True" Background="{TemplateBinding Background}"/>
                        <Border x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator" inf:Pill.IsRound="True"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding GoalMetToday}" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Background"
                                    Value="{DynamicResource Green}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
