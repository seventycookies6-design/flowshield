<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================== icons
         Segoe Fluent Icons, the Windows 11 icon font, with Segoe MDL2 Assets
         as the Windows 10 fallback (DESIGN_SYSTEM.md Part A, Type and icons).
         Both are part of Windows, so nothing is bundled and no notice ships.
         WPF falls back per character, so a glyph missing from the first family
         is drawn from the second. Every code point below exists in both.

         Basalt's own shield glyphs stay drawn geometry (ShieldGlyphs.xaml);
         the Causeway mark is BrandMark.xaml.

         Each icon is a one-character string, shown with the Icon or IconSmall
         TextBlock style:
             <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconToday}"/>
         To add one, find its code point in Microsoft's "Segoe Fluent Icons
         font" list and check it also exists in Segoe MDL2 Assets. -->

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Clock: Today -->
    <sys:String x:Key="IconToday">&#xE917;</sys:String>
    <!-- AreaChart: History. A chart rather than the History clock, which at
         20 px is hard to tell from the Today clock two rows above it. -->
    <sys:String x:Key="IconHistory">&#xE9D2;</sys:String>
    <!-- Blocked: Blocked Apps -->
    <sys:String x:Key="IconBlocked">&#xE733;</sys:String>
    <!-- QuietHours (a moon): Schedule -->
    <sys:String x:Key="IconSleep">&#xE708;</sys:String>
    <!-- Settings -->
    <sys:String x:Key="IconSettings">&#xE713;</sys:String>
    <!-- Refresh -->
    <sys:String x:Key="IconRefresh">&#xE72C;</sys:String>
    <!-- Calendar, and the calendar's month arrows -->
    <sys:String x:Key="IconCalendar">&#xE787;</sys:String>
    <sys:String x:Key="IconChevronLeft">&#xE76B;</sys:String>
    <sys:String x:Key="IconChevronRight">&#xE76C;</sys:String>
    <!-- ChevronDown: the disclosure and the dropdown -->
    <sys:String x:Key="IconChevronDown">&#xE70D;</sys:String>
    <!-- Cancel: a close (icon) button -->
    <sys:String x:Key="IconClose">&#xE711;</sys:String>
    <!-- More: a menu of further actions -->
    <sys:String x:Key="IconMore">&#xE712;</sys:String>
    <!-- Equalizer (sliders): Today's Set up, which opens the setup panel (#431) -->
    <sys:String x:Key="IconSetup">&#xE9E9;</sys:String>
    <!-- Play: Start on a template card (#431) -->
    <sys:String x:Key="IconPlay">&#xE768;</sys:String>
    <!-- Up: beside a momentum gain at the end of a sprint (#431) -->
    <sys:String x:Key="IconUp">&#xE74A;</sys:String>

    <!-- ============================================================== style
         Icon is the navigation and button size, 20; IconSmall is 16, for an
         icon sitting inline with text. The box is square and the glyph is
         centred in it, so a row of icons lines up whatever their shapes.

         Icons inherit the text colour of their context: leave Foreground
         unset and the parent's is used. Only an active item's icon is
         Primary. -->

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="IconSmall" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="LineHeight" Value="16"/>
    </Style>

</ResourceDictionary>
