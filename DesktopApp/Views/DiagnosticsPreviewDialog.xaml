<Window x:Class="FlowShield.Views.DiagnosticsPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Basalt"
        Width="680" Height="580" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource FontStack}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AutomationProperties.AutomationId="DiagnosticsPreviewDialog">
    <!-- Roadmap 4.3 (#400). The customer reads exactly what the file holds
         before copying or saving it. Basalt never sends it anywhere, and the
         dialog says so plainly (principle 5: previewable, opt-in). Close is
         IsCancel and IsDefault, so Escape and Enter dismiss it (§13). -->
    <Border Style="{StaticResource Card}" Margin="16" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Your diagnostics" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                <TextBlock Text="Nothing is sent. Attach this to an email only if you want to."
                           Style="{StaticResource Body}" Margin="0,8,0,0" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="DiagnosticsNothingSentText"/>
                <TextBlock Text="Your license key, email addresses and device IDs are removed, and so are your journal entries, sprint intentions and sprint history. Read it all below first."
                           Style="{StaticResource Caption}" Margin="0,8,0,12" TextWrapping="Wrap"/>
            </StackPanel>

            <TextBox x:Name="PreviewText" Grid.Row="1" Style="{StaticResource Field}"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                     AutomationProperties.AutomationId="DiagnosticsPreviewText"
                     AutomationProperties.Name="Diagnostics, read only"/>

            <TextBlock x:Name="StatusText" Grid.Row="2" Style="{StaticResource Caption}"
                       Margin="0,12,0,0" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="DiagnosticsStatusText"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource BtnGhost}" Content="Copy"
                        Click="OnCopy" Padding="16,8"
                        AutomationProperties.AutomationId="DiagnosticsCopyButton"
                        AutomationProperties.Name="Copy diagnostics"/>
                <Button Style="{StaticResource BtnGhost}" Content="Save as…"
                        Click="OnSave" Margin="12,0,0,0" Padding="16,8"
                        AutomationProperties.AutomationId="DiagnosticsSaveButton"
                        AutomationProperties.Name="Save diagnostics as a text file"/>
                <Button Style="{StaticResource BtnPrimary}" Content="Close"
                        IsDefault="True" IsCancel="True" Margin="12,0,0,0" Padding="24,8"
                        AutomationProperties.AutomationId="DiagnosticsCloseButton"
                        AutomationProperties.Name="Close"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
