<UserControl x:Class="FlowShield.Views.BlockedAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ==================================================== blocklist -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,18,0" Padding="24">
            <DockPanel>

                <!-- add row -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock Text="ADD AN APP TO BLOCK" Style="{StaticResource Eyebrow}" Margin="0,0,0,9"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource Field}"
                                 Text="{Binding NewAppName, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsEditable}"
                                 AutomationProperties.AutomationId="NewAppNameInput"
                                 AutomationProperties.Name="App or process name"
                                 AutomationProperties.HelpText="Process name such as slack, or a full path to an exe"/>
                        <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="Add"
                                Command="{Binding AddCommand}" Margin="9,0,0,0" Padding="24,10"
                                AutomationProperties.AutomationId="AddAppButton"
                                AutomationProperties.Name="Add blocked app"/>
                    </Grid>
                    <TextBlock Text="Type a process name — “slack”, “steam”, “chrome” — or paste a full path to an .exe."
                               Style="{StaticResource Caption}" Margin="2,8,0,0"/>
                </StackPanel>

                <!-- status strip -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Chip}" HorizontalAlignment="Left"
                        Margin="0,0,0,14">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}"
                               Foreground="{StaticResource InkDim}"
                               AutomationProperties.AutomationId="BlockedAppsStatusText"/>
                </Border>

                <!-- empty state -->
                <TextBlock DockPanel.Dock="Top"
                           Text="Nothing blocked yet. Add the app that pulls you away most."
                           Margin="2,20,0,0" HorizontalAlignment="Center"
                           AutomationProperties.AutomationId="BlockedAppsEmptyText">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Apps.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- the list -->
                <ListBox ItemsSource="{Binding Apps}"
                         SelectedItem="{Binding SelectedApp}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource PlainItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.AutomationId="BlockedAppsList"
                         AutomationProperties.Name="Blocked apps">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowCard}"
                                    Opacity="{Binding IsEnabled, Converter={StaticResource BoolOpacity}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                            Background="{StaticResource PrimarySoft}" BorderBrush="{StaticResource Primary}" BorderThickness="1"
                                            Margin="0,0,13,0">
                                        <TextBlock Text="⊘" FontSize="15" Foreground="{StaticResource VioletBright}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Ink}"
                                                   FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Caption}">
                                            <Run Text="{Binding ProcessName, Mode=OneWay}"/><Run Text=".exe"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0"
                                               Style="{StaticResource Caption}">
                                        <Run Text="blocked"/>
                                        <Run Text="{Binding BlockCount, Mode=OneWay}"
                                             Foreground="{StaticResource Rose}"/>
                                        <Run Text="×"/>
                                    </TextBlock>

                                    <Button Grid.Column="3" Style="{StaticResource BtnQuiet}" Content="Remove"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.AutomationId="{Binding ProcessName,
                                                                                StringFormat=RemoveApp_{0}}"
                                            AutomationProperties.Name="{Binding DisplayName,
                                                                       StringFormat=Remove {0}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================================== running processes -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid>
                        <TextBlock Text="RUNNING NOW" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource BtnQuiet}" Content="↻" FontSize="14"
                                HorizontalAlignment="Right" Padding="6,0"
                                Command="{Binding RefreshRunningCommand}"
                                AutomationProperties.AutomationId="RefreshProcessesButton"
                                AutomationProperties.Name="Refresh running processes"/>
                    </Grid>
                    <TextBlock Text="Protected system processes are hidden — FlowShield will never close those."
                               Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource BtnGhost}" Content="Block selected"
                        Command="{Binding AddRunningCommand}" Margin="0,12,0,0"
                        AutomationProperties.AutomationId="BlockSelectedProcessButton"/>

                <ListBox ItemsSource="{Binding RunningProcesses}"
                         SelectedItem="{Binding SelectedRunning}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource PickerItem}"
                         AutomationProperties.AutomationId="RunningProcessesList"
                         AutomationProperties.Name="Running processes"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
