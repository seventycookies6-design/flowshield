<UserControl x:Class="FlowShield.Views.BlockedAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="OnSizeChanged">
    <!-- Side by side when there is room, each card filling the height and
         scrolling its own list. Below that the picker stacks under the list and
         the page scrolls instead (code-behind, #189): split into fixed halves, a
         short window left each card too little room to show a single row. -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ListRow" Height="*"/>
            <RowDefinition x:Name="PickerRow" Height="0"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- Proportional, not a fixed 300px: at that width the picker cut
                 app names short at every window size (#189). -->
            <ColumnDefinition x:Name="PickerColumn" Width="0.65*" MinWidth="260" MaxWidth="460"/>
        </Grid.ColumnDefinitions>

        <!-- ==================================================== blocklist -->
        <Border x:Name="ListCard" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="24">
            <DockPanel>

                <!-- big-number header (UI-SPEC.md A3): the same "big
                     tabular number + one-line description" pattern as
                     Today's stat cards, applied here. text, not teal;
                     teal stays reserved for state/selection/progress. -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,24" VerticalAlignment="Bottom">
                    <TextBlock Style="{StaticResource Stat}" Text="{Binding Apps.Count, StringFormat={}{0:00}}"/>
                    <TextBlock Text="apps on the shield" Style="{StaticResource Body}" Foreground="{DynamicResource InkDim}"
                               VerticalAlignment="Bottom" Margin="12,0,0,4"/>
                </StackPanel>

                <!-- ===================================== profile switcher (F9)
                     Segmented chips (§7 "Segmented choices"), the same control
                     as sprint length and shield level, because this is the same
                     kind of choice: one of a few named things. The list below
                     edits the selected profile only. -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="BLOCKLIST PROFILE" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Profiles}"
                                  IsEnabled="{Binding CanSwitchProfile}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource Segment}" GroupName="BlocklistProfile"
                                             Margin="0,0,8,8"
                                             Content="{Binding Name}"
                                             IsChecked="{Binding IsActive, Mode=OneWay}"
                                             Command="{Binding DataContext.SelectProfileCommand,
                                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding}"
                                             AutomationProperties.AutomationId="{Binding Name, StringFormat=Profile_{0}}"
                                             AutomationProperties.Name="{Binding Name, StringFormat=Use the {0} blocklist}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource Field}"
                                 MaxLength="40"
                                 Text="{Binding ProfileNameText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditProfiles}"
                                 AutomationProperties.AutomationId="ProfileNameInput"
                                 AutomationProperties.Name="Profile name"
                                 AutomationProperties.HelpText="School, Gaming break, Everything"/>
                        <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="Rename"
                                Margin="8,0,0,0" Padding="16,0"
                                Command="{Binding RenameProfileCommand}"
                                AutomationProperties.AutomationId="RenameProfileButton"
                                AutomationProperties.Name="Rename this profile"/>
                        <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="New profile"
                                Margin="8,0,0,0" Padding="16,0"
                                Command="{Binding NewProfileCommand}"
                                AutomationProperties.AutomationId="NewProfileButton"
                                AutomationProperties.Name="Add a profile"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource BtnQuiet}" Content="Duplicate" Padding="12,0"
                                Command="{Binding DuplicateProfileCommand}"
                                AutomationProperties.AutomationId="DuplicateProfileButton"
                                AutomationProperties.Name="Duplicate this profile"/>
                        <Button Style="{StaticResource BtnDanger}" Content="Delete" Padding="12,0" Margin="8,0,0,0"
                                Command="{Binding DeleteProfileCommand}"
                                AutomationProperties.AutomationId="DeleteProfileButton"
                                AutomationProperties.Name="Delete this profile"/>
                    </StackPanel>

                    <!-- confirm before a profile's list goes with it -->
                    <Border Style="{StaticResource RowCard}" Padding="16" Margin="0,8,0,0"
                            Visibility="{Binding DeleteProfileConfirmVisible, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding DeleteProfileConfirmText}" Style="{StaticResource Body}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="DeleteProfileConfirmText"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource BtnDanger}" Content="Delete profile" Padding="16,0"
                                        Command="{Binding ConfirmDeleteProfileCommand}"
                                        AutomationProperties.AutomationId="ConfirmDeleteProfileButton"
                                        AutomationProperties.Name="Delete this profile for good"/>
                                <Button Style="{StaticResource BtnGhost}" Content="Keep it" Padding="16,0" Margin="8,0,0,0"
                                        Command="{Binding CancelDeleteProfileCommand}"
                                        AutomationProperties.AutomationId="CancelDeleteProfileButton"
                                        AutomationProperties.Name="Keep this profile"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Caption}" Margin="4,8,0,0" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ProfileHint"
                               Text="A profile is a named blocklist. A new one starts from the list you are looking at, so “School” or “Gaming break” is a copy with a few apps changed."/>
                </StackPanel>

                <!-- add row -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="ADD AN APP TO BLOCK" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource Field}"
                                 Text="{Binding NewAppName, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsEditable}"
                                 AutomationProperties.AutomationId="NewAppNameInput"
                                 AutomationProperties.Name="App or process name"
                                 AutomationProperties.HelpText="Process name such as slack, or a full path to an exe"/>
                        <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="Add"
                                Command="{Binding AddCommand}" Margin="8,0,0,0" Padding="24,12"
                                AutomationProperties.AutomationId="AddAppButton"
                                AutomationProperties.Name="Add blocked app"/>
                    </Grid>
                    <TextBlock Text="Find your app on the right, or type a process name here (“steam”) or paste the path to an .exe."
                               Style="{StaticResource Caption}" Margin="4,8,0,0"/>
                </StackPanel>

                <!-- status strip -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Chip}" HorizontalAlignment="Left"
                        Margin="0,0,0,16">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}"
                               Foreground="{DynamicResource InkDim}"
                               AutomationProperties.AutomationId="BlockedAppsStatusText"/>
                </Border>

                <!-- empty state -->
                <TextBlock DockPanel.Dock="Top"
                           Text="Nothing blocked yet. Add the app that pulls you away most."
                           Margin="4,24,0,0" HorizontalAlignment="Center"
                           AutomationProperties.AutomationId="BlockedAppsEmptyText">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Apps.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- the list -->
                <ListBox ItemsSource="{Binding Apps}"
                         SelectedItem="{Binding SelectedApp}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource PlainItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.AutomationId="BlockedAppsList"
                         AutomationProperties.Name="Blocked apps">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowCard}"
                                    Opacity="{Binding IsEnabled, Converter={StaticResource BoolOpacity}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}"
                                            Background="{DynamicResource PrimarySoft}" BorderBrush="{DynamicResource Primary}" BorderThickness="1"
                                            Margin="0,0,12,0">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconBlocked}"
                                              Stroke="{DynamicResource PrimaryHover}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name, category chip and process summary each get their own
                                         line instead of sharing one — this column only has ~156px to
                                         work with once the icon, "blocked N x" stat, Remove button and
                                         switch take their share (measured against after/A3/blocked-
                                         apps.png), nowhere near enough for two fields side by side once
                                         the category is a real multi-word label ("Games & Launchers")
                                         rather than the picker's short one-word categories. Cramming the
                                         chip and the process caption onto one line is what truncated
                                         both to unreadable fragments (review fix, PR #180). -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Label}" FontWeight="SemiBold"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}"/>
                                        <!-- category tag chip (UI-SPEC.md A3, graft from raycast). MaxWidth
                                             keeps a long category ("Games & Launchers") from overflowing
                                             its own line into the "blocked N x" column next to it — a
                                             Border with no size cap renders at its full desired width
                                             regardless of the column it sits in (WPF doesn't clip by
                                             default), which is exactly how this row got the review-flagged
                                             overlap the first time. -->
                                        <Border Style="{StaticResource TagChip}" Margin="0,4,0,0"
                                                HorizontalAlignment="Left" MaxWidth="140"
                                                Visibility="{Binding HasCategory, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ProcessSummary}">
                                            <Run Text="{Binding ProcessSummary, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0"
                                               Style="{StaticResource Caption}">
                                        <Run Text="blocked"/>
                                        <Run Text="{Binding BlockCount, Mode=OneWay}"
                                             Foreground="{DynamicResource Rose}"/>
                                        <Run Text="×"/>
                                    </TextBlock>

                                    <!-- destructive (UI-SPEC.md A3, §7 BtnDanger): removes the app from the
                                         blocklist, the closest thing to a "delete" action on this screen. -->
                                    <Button Grid.Column="3" Style="{StaticResource BtnDanger}" Content="Remove"
                                            Padding="12,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.AutomationId="{Binding ProcessName,
                                                                                StringFormat=RemoveApp_{0}}"
                                            AutomationProperties.Name="{Binding DisplayName,
                                                                       StringFormat=Remove {0}}"/>

                                    <CheckBox Grid.Column="4" Style="{StaticResource Switch}"
                                              VerticalAlignment="Center" Margin="12,0,0,0"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              IsEnabled="{Binding DataContext.CanEditApps,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              Command="{Binding DataContext.ToggleAppCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              CommandParameter="{Binding}"
                                              AutomationProperties.AutomationId="{Binding ProcessName,
                                                                                  StringFormat=AppEnabledSwitch_{0}}"
                                              AutomationProperties.Name="{Binding DisplayName,
                                                                         StringFormat=Enable {0}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ====================================================== app picker (F8) -->
        <Border x:Name="PickerCard" Grid.Column="1" Style="{StaticResource Card}" Padding="24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid>
                        <TextBlock Text="FIND AN APP" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource BtnQuiet}" HorizontalAlignment="Right" Padding="8,0"
                                Command="{Binding RefreshRunningCommand}"
                                AutomationProperties.AutomationId="RefreshProcessesButton"
                                AutomationProperties.Name="Refresh installed and running apps">
                            <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconRefresh}"/>
                        </Button>
                    </Grid>
                    <TextBox Style="{StaticResource Field}" Margin="0,8,0,0"
                             Text="{Binding PickerQuery, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditable}"
                             AutomationProperties.AutomationId="AppSearchInput"
                             AutomationProperties.Name="Search apps"
                             AutomationProperties.HelpText="Discord, Steam, Minecraft…"/>
                    <TextBlock Text="{Binding PickerNotice}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Amber}" Margin="4,8,0,0"
                               Visibility="{Binding HasPickerNotice, Converter={StaticResource BoolVis}}"
                               AutomationProperties.AutomationId="AppSearchNotice"/>
                </StackPanel>

                <ListBox ItemsSource="{Binding PickerResults}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource PlainItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         AutomationProperties.AutomationId="AppPickerList"
                         AutomationProperties.Name="Apps you can block">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <Border CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource PrimarySoft}"
                                            Visibility="{Binding HasIcon, Converter={StaticResource InvBoolVis}}">
                                        <TextBlock Text="{Binding Initial}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Ink}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Image Source="{Binding Icon}" Width="24" Height="24"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource Ink}"
                                                   FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <!-- category tag chip (UI-SPEC.md A3, graft from raycast):
                                             "Music", "Chat", "Browsers", "Utilities" … A Grid column, not a
                                             StackPanel, so the chip can't overflow this narrow picker list. -->
                                        <Border Grid.Column="1" Style="{StaticResource TagChip}" Margin="8,0,0,0"
                                                VerticalAlignment="Center" MaxWidth="76"
                                                Visibility="{Binding HasGroup, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding Group}" Style="{StaticResource Caption}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource Caption}"
                                               Visibility="{Binding HasSourceLabel, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Amber}"
                                               Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>

                                <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Padding="12,4"
                                        VerticalAlignment="Top" Margin="8,0,0,0"
                                        Content="{Binding ActionLabel}"
                                        Command="{Binding DataContext.PickCommand,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                        AutomationProperties.Name="{Binding ActionName}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
