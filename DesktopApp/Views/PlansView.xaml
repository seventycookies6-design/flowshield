<UserControl x:Class="FlowShield.Views.PlansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FlowShield.Views">
    <!-- Plans (#433): what Basalt blocks and what starts by itself, on one
         page. Blocklists across the top, then Schedules and Templates side by
         side (ScheduleView), stacking on a narrow window. The page is the one
         thing that scrolls: no section has a scroll of its own, so the wheel
         always moves the page (DESIGN_SYSTEM.md section 4).
         Not focusable: a focusable ScrollViewer takes a Tab stop of its own and
         draws a dashed rectangle round the whole page. Every control inside
         keeps its tab stop, and Page Up/Down from any of them still scrolls it. -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  AutomationProperties.AutomationId="PlansPageScroll">
        <StackPanel Margin="0,0,8,8">
            <views:BlockedAppsView x:Name="BlocklistsSection" DataContext="{Binding BlockedApps}"/>
            <views:ScheduleView x:Name="SchedulesSection" DataContext="{Binding Schedule}" Margin="0,24,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
