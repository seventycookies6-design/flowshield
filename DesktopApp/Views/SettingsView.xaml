<UserControl x:Class="FlowShield.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:FlowShield.Infrastructure">
    <Grid SizeChanged="OnRootSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- F22: the section rail. WrapPanel (not StackPanel) on purpose — it
             flips Orientation to Horizontal on narrow windows (RailBreakpoint,
             code-behind), becoming a wrapping chip row above the groups. It
             tracks scroll position via OnScrollChanged (code-behind) and
             jumps via OnNavClick / JumpTo. -->
        <WrapPanel x:Name="Rail" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Orientation="Vertical" Margin="0,0,16,0"
                   KeyboardNavigation.DirectionalNavigation="None"
                   AutomationProperties.Name="Settings sections">
            <RadioButton x:Name="SettingsNav_Licence" Style="{StaticResource SettingsNavLink}"
                         GroupName="SettingsNav" Tag="Licence" Content="Licence &amp; devices" IsChecked="True"
                         AutomationProperties.AutomationId="SettingsNav_Licence" Click="OnNavClick" PreviewKeyDown="OnNavKeyDown"/>
            <RadioButton x:Name="SettingsNav_Focus" Style="{StaticResource SettingsNavLink}"
                         GroupName="SettingsNav" Tag="Focus" Content="Focus"
                         AutomationProperties.AutomationId="SettingsNav_Focus" Click="OnNavClick" PreviewKeyDown="OnNavKeyDown"/>
            <RadioButton x:Name="SettingsNav_App" Style="{StaticResource SettingsNavLink}"
                         GroupName="SettingsNav" Tag="App" Content="App"
                         AutomationProperties.AutomationId="SettingsNav_App" Click="OnNavClick" PreviewKeyDown="OnNavKeyDown"/>
            <RadioButton x:Name="SettingsNav_Notifications" Style="{StaticResource SettingsNavLink}"
                         GroupName="SettingsNav" Tag="Notifications" Content="Notifications"
                         AutomationProperties.AutomationId="SettingsNav_Notifications" Click="OnNavClick" PreviewKeyDown="OnNavKeyDown"/>
            <RadioButton x:Name="SettingsNav_Data" Style="{StaticResource SettingsNavLink}"
                         GroupName="SettingsNav" Tag="Data" Content="Your data"
                         AutomationProperties.AutomationId="SettingsNav_Data" Click="OnNavClick" PreviewKeyDown="OnNavKeyDown"/>
            <RadioButton x:Name="SettingsNav_About" Style="{StaticResource SettingsNavLink}"
                         GroupName="SettingsNav" Tag="About" Content="About"
                         AutomationProperties.AutomationId="SettingsNav_About" Click="OnNavClick" PreviewKeyDown="OnNavKeyDown"/>
        </WrapPanel>

    <ScrollViewer x:Name="SettingsScroll" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                  ScrollChanged="OnScrollChanged">
        <!-- DESIGN_SYSTEM.md §4: the cards flow into two columns when the
             window is wide enough (three on a very wide one) and stack when it
             isn't, full width like Today and Blocked Apps (#189). This was one
             720px column, centred. F22: Settings is now six labelled groups,
             each with its own header and adaptive-column row of cards. -->
        <StackPanel x:Name="GroupsPanel" Margin="0,0,8,0">

            <!-- ================================================== licence -->
            <StackPanel x:Name="Group_Licence">
                <TextBlock x:Name="Header_Licence" Text="Licence" Style="{StaticResource SettingsGroupHeader}"
                           Margin="0,0,0,12"
                           AutomationProperties.AutomationId="SettingsGroup_Licence"/>
                <inf:AdaptiveColumns MinColumnWidth="400" MaxColumns="3" Spacing="16">
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="LICENSE" Style="{StaticResource Eyebrow}"/>

                                    <!-- big-number treatment (UI-SPEC.md A3), matching the
                                         app-pages sketch's "05 days left on free trial":
                                         text, not teal, and only while the trial is the
                                         active state (Pro and trial-ended have no count to show). -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                Visibility="{Binding IsTrial, Converter={StaticResource BoolVis}}">
                                        <TextBlock Style="{StaticResource Stat}"
                                                   Text="{Binding TrialDaysLeft, StringFormat={}{0:00}}"/>
                                        <TextBlock Text="days left on free trial" Style="{StaticResource Body}"
                                                   Foreground="{DynamicResource InkDim}"
                                                   VerticalAlignment="Bottom" Margin="12,0,0,4"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding LicenseStatusText}"
                                               Style="{StaticResource H2}" Margin="0,8,0,0"
                                               AutomationProperties.AutomationId="LicenseStatusText"/>
                                    <TextBlock Text="{Binding LicenseDetailText}" Style="{StaticResource Caption}"
                                               Margin="0,4,0,0"
                                               AutomationProperties.AutomationId="LicenseDetailText"/>

                                    <TextBlock Text="{Binding DeviceText}" Style="{StaticResource Caption}"
                                               Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="420"
                                               HorizontalAlignment="Left"
                                               Foreground="{DynamicResource InkFaint}"
                                               Visibility="{Binding HasDeviceInfo, Converter={StaticResource BoolVis}}"
                                               AutomationProperties.AutomationId="DeviceText"/>
                                </StackPanel>

                                <Button Style="{StaticResource BtnPrimary}" Content="Buy FlowShield — $4.99"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Command="{Binding GetProCommand}"
                                        Visibility="{Binding IsNotPro, Converter={StaticResource BoolVis}}"
                                        AutomationProperties.AutomationId="GetProButton"
                                        AutomationProperties.Name="Buy FlowShield"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Edge}" Margin="0,0,0,16"/>

                            <TextBlock Text="LICENSE KEY" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                            <TextBox Style="{StaticResource Field}"
                                     Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Cascadia Mono, Consolas, monospace"
                                     AutomationProperties.AutomationId="LicenseKeyInput"
                                     AutomationProperties.Name="License key"
                                     AutomationProperties.HelpText="FS-XXXX-XXXX-XXXX-XXXX"/>

                            <TextBlock Text="EMAIL USED AT CHECKOUT (OPTIONAL)" Style="{StaticResource Eyebrow}"
                                       Margin="0,16,0,8"/>
                            <TextBox Style="{StaticResource Field}"
                                     Text="{Binding LicenseEmailInput, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="LicenseEmailInput"
                                     AutomationProperties.Name="License email"/>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource BtnPrimary}" Content="Activate licence"
                                        Command="{Binding ActivateCommand}" Padding="24,12"
                                        AutomationProperties.AutomationId="ActivateProButton"
                                        AutomationProperties.Name="Activate licence"/>

                                <Button Style="{StaticResource BtnQuiet}" Content="Deactivate"
                                        Command="{Binding DeactivateCommand}" Margin="8,0,0,0"
                                        Visibility="{Binding IsPro, Converter={StaticResource BoolVis}}"
                                        AutomationProperties.AutomationId="DeactivateButton"/>

                                <TextBlock Text="Checking…" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
                                           AutomationProperties.AutomationId="LicenseBusyText"/>
                            </StackPanel>

                            <!-- ============================== your devices (Roadmap 5.7) -->
                            <!-- Fetched only when this expands (the first time) or Refresh is
                                 pressed — never polled. Only shown once there is a licence to
                                 list seats for. -->
                            <StackPanel Visibility="{Binding IsPro, Converter={StaticResource BoolVis}}">
                                <Border Height="1" Background="{DynamicResource Edge}" Margin="0,16,0,16"/>

                                <Grid>
                                    <Button Style="{StaticResource BtnQuiet}" Content="Your devices"
                                            Command="{Binding ToggleDevicesCommand}" Padding="0" HorizontalAlignment="Left"
                                            AutomationProperties.AutomationId="DevicesToggleButton"
                                            AutomationProperties.Name="Your devices"/>

                                    <Button Style="{StaticResource BtnQuiet}" Content="Refresh"
                                            Command="{Binding RefreshDevicesCommand}" Padding="0" HorizontalAlignment="Right"
                                            Visibility="{Binding IsDevicesExpanded, Converter={StaticResource BoolVis}}"
                                            AutomationProperties.AutomationId="DevicesRefreshButton"/>
                                </Grid>

                                <StackPanel Visibility="{Binding IsDevicesExpanded, Converter={StaticResource BoolVis}}"
                                            Margin="0,12,0,0">
                                    <TextBlock Text="Loading…" Style="{StaticResource Caption}"
                                               Visibility="{Binding IsLoadingDevices, Converter={StaticResource BoolVis}}"
                                               AutomationProperties.AutomationId="DevicesLoadingText"/>

                                    <TextBlock Text="{Binding DevicesStatusText}" Style="{StaticResource Caption}"
                                               Foreground="{DynamicResource Rose}"
                                               Visibility="{Binding DevicesStatusText, Converter={StaticResource NonEmptyVis}}"
                                               AutomationProperties.AutomationId="DevicesStatusText"/>

                                    <ItemsControl ItemsSource="{Binding Devices}"
                                                  AutomationProperties.AutomationId="DevicesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowCard}" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Label}"
                                                                       AutomationProperties.AutomationId="{Binding DeviceToken, StringFormat=DeviceName_{0}}"/>
                                                            <TextBlock Text="{Binding LastSeenText}" Style="{StaticResource Caption}"
                                                                       Margin="0,4,0,0"/>
                                                        </StackPanel>

                                                        <!-- Two-step: Release swaps to an explicit confirm/cancel
                                                             pair (DESIGN_SYSTEM.md §7 — quiet, low-emphasis, but a
                                                             seat release still gets a confirmation) rather than
                                                             acting on the first click. -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding CanRelease, Converter={StaticResource BoolVis}}">
                                                            <StackPanel Orientation="Horizontal"
                                                                        Visibility="{Binding IsConfirmingRelease,
                                                                                    Converter={StaticResource InvBoolVis}}">
                                                                <Button Style="{StaticResource BtnQuiet}" Content="Release"
                                                                        Padding="12,0"
                                                                        Command="{Binding DataContext.RequestReleaseCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        AutomationProperties.AutomationId="{Binding DeviceToken, StringFormat=ReleaseDevice_{0}}"
                                                                        AutomationProperties.Name="{Binding Name, StringFormat=Release {0}}"/>
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal"
                                                                        Visibility="{Binding IsConfirmingRelease, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="Release this device?" Style="{StaticResource Caption}"
                                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <Button Style="{StaticResource BtnDanger}" Content="Yes, release"
                                                                        Padding="12,0" IsEnabled="{Binding IsReleasing, Converter={StaticResource InvBool}}"
                                                                        Command="{Binding DataContext.ConfirmReleaseCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        AutomationProperties.AutomationId="{Binding DeviceToken, StringFormat=ConfirmReleaseDevice_{0}}"/>
                                                                <Button Style="{StaticResource BtnQuiet}" Content="Cancel"
                                                                        Padding="12,0" Margin="4,0,0,0"
                                                                        Command="{Binding DataContext.CancelReleaseCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        AutomationProperties.AutomationId="{Binding DeviceToken, StringFormat=CancelReleaseDevice_{0}}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </inf:AdaptiveColumns>
            </StackPanel>

            <!-- ==================================================== focus -->
            <StackPanel x:Name="Group_Focus">
                <TextBlock x:Name="Header_Focus" Text="Focus" Style="{StaticResource SettingsGroupHeader}"
                           AutomationProperties.AutomationId="SettingsGroup_Focus"/>
                <inf:AdaptiveColumns MinColumnWidth="400" MaxColumns="3" Spacing="16">

                    <!-- ================================================ daily goal -->
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="DAILY GOAL" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                            <TextBlock Text="With a goal set, a day counts towards your streak only once you reach it."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <RadioButton GroupName="DailyGoal" Content="No goal" IsChecked="{Binding GoalOff}"
                                         Foreground="{DynamicResource Ink}" FontSize="13" Margin="0,0,0,12"
                                         AutomationProperties.AutomationId="GoalOffRadio"/>
                            <RadioButton GroupName="DailyGoal" Content="Minutes focused" IsChecked="{Binding GoalInMinutes}"
                                         Foreground="{DynamicResource Ink}" FontSize="13" Margin="0,0,0,12"
                                         AutomationProperties.AutomationId="GoalMinutesRadio"/>
                            <RadioButton GroupName="DailyGoal" Content="Sprints completed" IsChecked="{Binding GoalInSprints}"
                                         Foreground="{DynamicResource Ink}" FontSize="13"
                                         AutomationProperties.AutomationId="GoalSprintsRadio"/>

                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding GoalTargetVisible, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="72" Text="{Binding GoalTargetText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Field}"
                                             AutomationProperties.AutomationId="GoalTargetInput"
                                             AutomationProperties.Name="Daily goal target"/>
                                    <TextBlock Text="{Binding GoalUnitLabel}" Style="{StaticResource Body}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               AutomationProperties.AutomationId="GoalUnitLabel"/>
                                </StackPanel>
                                <TextBlock Text="{Binding GoalTargetError}" Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource Rose}" Margin="0,8,0,0"
                                           Visibility="{Binding GoalTargetErrorVisible, Converter={StaticResource BoolVis}}"
                                           AutomationProperties.AutomationId="GoalTargetError"/>

                                <Border Height="1" Background="{DynamicResource Edge}" Margin="0,16,0,16"/>

                                <TextBlock Text="A planned day off keeps your streak without counting as focus."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding SkipTodayCommand}"
                                            Style="{StaticResource BtnQuiet}"
                                            AutomationProperties.AutomationId="SkipTodayButton"
                                            AutomationProperties.Name="{Binding SkipButtonText}">
                                        <TextBlock Text="{Binding SkipButtonText}"/>
                                    </Button>
                                    <TextBlock Text="{Binding SkipRemainingText}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               AutomationProperties.AutomationId="SkipRemainingText"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- =================================================== breaks (F5) -->
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="BREAKS" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                            <TextBlock Text="A break is offered after a sprint finishes. The sprint's shield is down while one runs (a nightly sleep window still applies), and a break changes nothing about your momentum, streak or daily goal."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <TextBlock Text="BREAK LENGTH" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="72" Style="{StaticResource Field}"
                                         Text="{Binding ShortBreakMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="ShortBreakMinutesInput"
                                         AutomationProperties.Name="Break length in minutes"/>
                                <TextBlock Text="minutes" Style="{StaticResource Body}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding BreakMinutesError}" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource Amber}" Margin="0,8,0,0"
                                       Visibility="{Binding ShortBreakErrorVisible, Converter={StaticResource BoolVis}}"
                                       AutomationProperties.AutomationId="ShortBreakMinutesError"/>

                            <TextBlock Text="LONGER BREAK" Style="{StaticResource Eyebrow}" Margin="0,16,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="72" Style="{StaticResource Field}"
                                         Text="{Binding LongBreakMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="LongBreakMinutesInput"
                                         AutomationProperties.Name="Longer break length in minutes"/>
                                <TextBlock Text="minutes" Style="{StaticResource Body}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding BreakMinutesError}" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource Amber}" Margin="0,8,0,0"
                                       Visibility="{Binding LongBreakErrorVisible, Converter={StaticResource BoolVis}}"
                                       AutomationProperties.AutomationId="LongBreakMinutesError"/>
                            <TextBlock Text="{Binding LongBreakExplanation}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       AutomationProperties.AutomationId="LongBreakExplanation"/>
                        </StackPanel>
                    </Border>

                    <!-- ==================================================== shields -->
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="SHIELDS" Style="{StaticResource Eyebrow}" Margin="0,0,0,16"/>

                            <!-- F7 / roadmap 1.7: Soft closes nothing on its own, so the
                                 notice is the whole intervention. On by default. -->
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowSoftOverlayEnabled}"
                                      AutomationProperties.AutomationId="SoftOverlayToggle"
                                      AutomationProperties.Name="Show a full-screen notice at Soft">
                                <StackPanel>
                                    <TextBlock Text="Show a full-screen notice at Soft" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding SoftOverlayCaption}"
                                               Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource Edge}" Margin="0,16,0,16"/>

                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HardKillModeEnabled}"
                                      IsEnabled="{Binding HasAccess}"
                                      AutomationProperties.AutomationId="HardKillModeToggle"
                                      AutomationProperties.Name="Hard kill mode">
                                <StackPanel>
                                    <TextBlock Text="Hard kill mode" Style="{StaticResource Label}"/>
                                    <TextBlock Text="Terminate blocked apps the moment they launch — no grace period."
                                               Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </inf:AdaptiveColumns>
            </StackPanel>

            <!-- ====================================================== app -->
            <StackPanel x:Name="Group_App">
                <TextBlock x:Name="Header_App" Text="App" Style="{StaticResource SettingsGroupHeader}"
                           AutomationProperties.AutomationId="SettingsGroup_App"/>
                <inf:AdaptiveColumns MinColumnWidth="400" MaxColumns="3" Spacing="16">

                    <!-- =============================================== preferences -->
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="PREFERENCES" Style="{StaticResource Eyebrow}" Margin="0,0,0,16"/>

                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}"
                                      AutomationProperties.AutomationId="StartWithWindowsToggle"
                                      AutomationProperties.Name="Start with Windows">
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" Style="{StaticResource Label}"/>
                                    <TextBlock Text="Launches minimised to the tray at sign-in."
                                               Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource Edge}" Margin="0,16,0,16"/>

                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTrayOnClose}"
                                      AutomationProperties.AutomationId="MinimizeToTrayToggle"
                                      AutomationProperties.Name="Minimize to tray on close">
                                <StackPanel>
                                    <TextBlock Text="Minimise to tray on close" Style="{StaticResource Label}"/>
                                    <TextBlock Text="Closing the window keeps the shield running in the background."
                                               Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource Edge}" Margin="0,16,0,16"/>

                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GlobalHotkeyEnabled}"
                                      AutomationProperties.AutomationId="GlobalHotkeyToggle"
                                      AutomationProperties.Name="Start the last sprint from anywhere">
                                <StackPanel>
                                    <TextBlock Text="Start the last sprint from anywhere" Style="{StaticResource Label}"/>
                                    <TextBlock Text="Off by default. Press Ctrl+Alt+F from any app to start your last sprint, even while FlowShield is in the tray. Turns itself off if another app already uses that combination."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- ================================================= appearance -->
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="APPEARANCE" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                            <TextBlock Text="System follows the light or dark setting Windows is on, and changes with it."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <!-- Ids go on the three controls, never on this panel: an
                                 AutomationId on a layout panel is not surfaced (#134). -->
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="AppTheme" Content="System"
                                             IsChecked="{Binding ThemeIsSystem}"
                                             AutomationProperties.AutomationId="ThemeSystemRadio"
                                             AutomationProperties.Name="System theme"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="AppTheme" Content="Dark"
                                             IsChecked="{Binding ThemeIsDark}"
                                             AutomationProperties.AutomationId="ThemeDarkRadio"
                                             AutomationProperties.Name="Dark theme"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="AppTheme" Content="Light"
                                             IsChecked="{Binding ThemeIsLight}"
                                             AutomationProperties.AutomationId="ThemeLightRadio"
                                             AutomationProperties.Name="Light theme"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </inf:AdaptiveColumns>
            </StackPanel>

            <!-- ============================================== notifications -->
            <StackPanel x:Name="Group_Notifications">
                <TextBlock x:Name="Header_Notifications" Text="Notifications" Style="{StaticResource SettingsGroupHeader}"
                           AutomationProperties.AutomationId="SettingsGroup_Notifications"/>
                <inf:AdaptiveColumns MinColumnWidth="400" MaxColumns="3" Spacing="16">
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="NOTIFICATIONS" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                            <TextBlock Text="FlowShield notifies from the tray, and never about buying while a sprint is running."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotificationsEnabled}"
                                      AutomationProperties.AutomationId="NotificationsToggle"
                                      AutomationProperties.Name="Notifications">
                                <TextBlock Text="Notifications" Style="{StaticResource Label}"/>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource Edge}" Margin="0,16,0,16"/>

                            <StackPanel IsEnabled="{Binding NotificationsEnabled}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifySprintStarted}"
                                          AutomationProperties.AutomationId="NotifySprintStartedToggle"
                                          AutomationProperties.Name="Sprint started">
                                    <TextBlock Text="Sprint started" Style="{StaticResource Label}"/>
                                </CheckBox>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyFiveMinutesLeft}"
                                          Margin="0,16,0,0"
                                          AutomationProperties.AutomationId="NotifyFiveMinutesLeftToggle"
                                          AutomationProperties.Name="Five minutes left">
                                    <TextBlock Text="5 minutes left" Style="{StaticResource Label}"/>
                                </CheckBox>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifySprintComplete}"
                                          Margin="0,16,0,0"
                                          AutomationProperties.AutomationId="NotifySprintCompleteToggle"
                                          AutomationProperties.Name="Sprint complete">
                                    <TextBlock Text="Sprint complete" Style="{StaticResource Label}"/>
                                </CheckBox>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifySprintInterrupted}"
                                          Margin="0,16,0,0"
                                          AutomationProperties.AutomationId="NotifySprintInterruptedToggle"
                                          AutomationProperties.Name="Sprint interrupted">
                                    <StackPanel>
                                        <TextBlock Text="Sprint interrupted" Style="{StaticResource Label}"/>
                                        <TextBlock Text="When a sprint is picked up again after a restart or a crash."
                                                   Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyBreakOver}"
                                          Margin="0,16,0,0"
                                          AutomationProperties.AutomationId="NotifyBreakOverToggle"
                                          AutomationProperties.Name="Break over">
                                    <TextBlock Text="Break over" Style="{StaticResource Label}"/>
                                </CheckBox>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyScheduledSprint}"
                                          Margin="0,16,0,0"
                                          AutomationProperties.AutomationId="NotifyScheduledSprintToggle"
                                          AutomationProperties.Name="Scheduled sprint">
                                    <StackPanel>
                                        <TextBlock Text="Scheduled sprint" Style="{StaticResource Label}"/>
                                        <TextBlock Text="Five minutes before a schedule starts, when one starts without asking, and when one was missed."
                                                   Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyAppClosing}"
                                          Margin="0,16,0,0"
                                          AutomationProperties.AutomationId="NotifyAppClosingToggle"
                                          AutomationProperties.Name="Blocked app closing">
                                    <StackPanel>
                                        <TextBlock Text="A blocked app is closing" Style="{StaticResource Label}"/>
                                        <TextBlock Text="A few seconds' warning before it closes, so you can save."
                                                   Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyTrialEnding}"
                                          Margin="0,16,0,0"
                                          AutomationProperties.AutomationId="NotifyTrialEndingToggle"
                                          AutomationProperties.Name="Trial ending">
                                    <StackPanel>
                                        <TextBlock Text="Free trial ending" Style="{StaticResource Label}"/>
                                        <TextBlock Text="Once, on the last day. Never during a sprint."
                                                   Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </inf:AdaptiveColumns>
            </StackPanel>

            <!-- ===================================================== data -->
            <StackPanel x:Name="Group_Data">
                <TextBlock x:Name="Header_Data" Text="Data" Style="{StaticResource SettingsGroupHeader}"
                           AutomationProperties.AutomationId="SettingsGroup_Data"/>
                <inf:AdaptiveColumns MinColumnWidth="400" MaxColumns="3" Spacing="16">

                    <!-- ============================================ journal export -->
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="EXPORT YOUR JOURNAL" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                            <TextBlock Text="Save your sprints and journal lines as a file you keep. It is written only where you choose — nothing is uploaded."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="FROM" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                                    <DatePicker SelectedDate="{Binding ExportFrom}" Width="150"
                                                AutomationProperties.AutomationId="ExportFromDate"
                                                AutomationProperties.Name="Export from date"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="TO" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                                    <DatePicker SelectedDate="{Binding ExportTo}" Width="150"
                                                AutomationProperties.AutomationId="ExportToDate"
                                                AutomationProperties.Name="Export to date"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <RadioButton GroupName="ExportFormat" Content="CSV (spreadsheet)"
                                             IsChecked="{Binding ExportAsCsv}"
                                             Foreground="{DynamicResource Ink}" FontSize="13"
                                             AutomationProperties.AutomationId="ExportCsvRadio"/>
                                <RadioButton GroupName="ExportFormat" Content="Markdown"
                                             IsChecked="{Binding ExportAsMarkdown}" Margin="24,0,0,0"
                                             Foreground="{DynamicResource Ink}" FontSize="13"
                                             AutomationProperties.AutomationId="ExportMarkdownRadio"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BtnPrimary}" Content="Export…"
                                        Command="{Binding ExportJournalCommand}" Padding="24,12"
                                        AutomationProperties.AutomationId="ExportJournalButton"
                                        AutomationProperties.Name="Export journal"/>
                                <TextBlock Text="{Binding ExportRangeText}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"
                                           AutomationProperties.AutomationId="ExportRangeText"/>
                            </StackPanel>

                            <TextBlock Text="{Binding ExportStatusText}" Style="{StaticResource Caption}"
                                       Margin="0,12,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding ExportStatusVisible, Converter={StaticResource BoolVis}}"
                                       AutomationProperties.AutomationId="ExportStatusText"/>
                        </StackPanel>
                    </Border>

                    <!-- =================================================== your data -->
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="YOUR DATA" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16">
                                <Run Text="Sessions, journal, blocklist, momentum and your licence are stored on this PC, encrypted with Windows DPAPI, at"/>
                                <Run Text="{Binding DataFilePath, Mode=OneWay}" Foreground="{DynamicResource InkDim}"/>
                                <Run Text=". A logs folder sits beside it."/>
                            </TextBlock>
                            <TextBlock Text="The only thing that ever leaves this PC is the licence check: your licence key, the email you used at checkout, a salted device identifier, and your device name, sent to the licence server to confirm your purchase."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"
                                       AutomationProperties.AutomationId="WhatLeavesText"/>

                            <Border Height="1" Background="{DynamicResource Edge}" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BtnGhost}" Content="Export everything…"
                                        Command="{Binding ExportDataCommand}" Padding="16,8"
                                        AutomationProperties.AutomationId="ExportDataButton"
                                        AutomationProperties.Name="Export everything"/>

                                <Button Style="{StaticResource BtnDanger}" Content="Delete everything"
                                        Command="{Binding DeleteEverythingCommand}" Margin="8,0,0,0" Padding="16,8"
                                        AutomationProperties.AutomationId="DeleteEverythingButton"
                                        AutomationProperties.Name="Delete everything"/>
                            </StackPanel>

                            <TextBlock Text="{Binding DataStatusText}" Style="{StaticResource Caption}"
                                       Margin="0,12,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding DataStatusVisible, Converter={StaticResource BoolVis}}"
                                       AutomationProperties.AutomationId="DataStatusText"/>

                            <!-- Same guard as RestartForUpdate: relaunching mid-sprint would
                                 drop a Sealed shield, so Delete everything waits too. -->
                            <TextBlock Text="Finish your sprint first — deleting everything restarts the app, which would end it."
                                       Style="{StaticResource Caption}" Foreground="{DynamicResource Rose}"
                                       Margin="0,12,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding DataContext.IsSprintRunning,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource BoolVis}}"
                                       AutomationProperties.AutomationId="DeleteEverythingBlockedText"/>
                        </StackPanel>
                    </Border>
                </inf:AdaptiveColumns>
            </StackPanel>

            <!-- ==================================================== about -->
            <StackPanel x:Name="Group_About">
                <TextBlock x:Name="Header_About" Text="About" Style="{StaticResource SettingsGroupHeader}"
                           AutomationProperties.AutomationId="SettingsGroup_About"/>
                <inf:AdaptiveColumns MinColumnWidth="400" MaxColumns="3" Spacing="16">

                    <!-- ==================================================== updates -->
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="UPDATES" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>

                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Label}"
                                       AutomationProperties.AutomationId="VersionText"/>

                            <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource Caption}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="UpdateStatusText"/>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource BtnGhost}" Content="Check for updates"
                                        Command="{Binding CheckForUpdatesCommand}"
                                        AutomationProperties.AutomationId="CheckForUpdatesButton"/>

                                <Button Style="{StaticResource BtnPrimary}" Content="Restart to update"
                                        Command="{Binding RestartForUpdateCommand}" Margin="8,0,0,0"
                                        Visibility="{Binding UpdateReady, Converter={StaticResource BoolVis}}"
                                        AutomationProperties.AutomationId="RestartForUpdateButton"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- =================================================== advanced -->
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="ADVANCED" Style="{StaticResource Eyebrow}" Margin="0,0,0,16"/>

                            <StackPanel x:Name="DevOnlyFields">
                                <TextBlock Text="License server" Style="{StaticResource Caption}" Margin="4,0,0,8"/>
                                <TextBox Style="{StaticResource Field}"
                                         Text="{Binding LicenseServerUrl, UpdateSourceTrigger=LostFocus}"
                                         AutomationProperties.AutomationId="LicenseServerUrlInput"
                                         AutomationProperties.Name="License server URL"/>

                                <TextBlock Style="{StaticResource Caption}" Margin="4,16,0,0" TextWrapping="Wrap">
                                    <Run Text="Settings are DPAPI-encrypted at"/>
                                    <Run Text="{Binding SettingsFilePath, Mode=OneWay}" Foreground="{DynamicResource InkDim}"/>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Text="{Binding DataContext.TermsAcceptedText,
                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                       Style="{StaticResource Caption}" Margin="4,16,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding DataContext.HasAcceptedTerms,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource BoolVis}}"
                                       AutomationProperties.AutomationId="TermsAcceptedText"/>

                            <StackPanel Orientation="Horizontal" Margin="-12,4,0,0">
                                <Button Style="{StaticResource BtnQuiet}" Content="Terms of service"
                                        Command="{Binding DataContext.OpenTermsCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.AutomationId="SettingsTermsButton"/>
                                <Button Style="{StaticResource BtnQuiet}" Content="Privacy policy"
                                        Command="{Binding DataContext.OpenPrivacyCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.AutomationId="SettingsPrivacyButton"/>
                            </StackPanel>

                            <Button Style="{StaticResource BtnQuiet}" Content="Show the welcome again"
                                    HorizontalAlignment="Left" Margin="-12,12,0,0"
                                    Command="{Binding DataContext.ShowFirstRunCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    AutomationProperties.AutomationId="ShowFirstRunButton"/>

                            <Button Style="{StaticResource BtnQuiet}" Content="Open diagnostic log"
                                    HorizontalAlignment="Left" Margin="-12,12,0,0"
                                    Command="{Binding OpenLogCommand}"
                                    AutomationProperties.AutomationId="OpenLogButton"/>
                        </StackPanel>
                    </Border>
                </inf:AdaptiveColumns>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
