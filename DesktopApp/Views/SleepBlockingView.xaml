<UserControl x:Class="FlowShield.Views.SleepBlockingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:FlowShield.Infrastructure"
             xmlns:vm="clr-namespace:FlowShield.ViewModels">
    <!-- DESIGN_SYSTEM.md §4: full width, like Today and Blocked Apps.
         The status and the schedule sit side by side when there is room and
         stack when there is not (#189); this used to be one 700px column
         centred in the window. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">

            <!-- trial-ended gate (the window-wide lock screen normally covers this) -->
            <ContentControl Style="{StaticResource CardTinted}" Margin="0,0,0,16"
                            Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Your free trial has ended" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                                   Text="Buy Basalt once for $4.99 to keep your nightly shield."/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="Buy Basalt"
                            VerticalAlignment="Center" Command="{Binding GetProCommand}"
                            AutomationProperties.AutomationId="SleepGetProButton"/>
                </Grid>
            </ContentControl>

            <!-- The window only works while Basalt runs (roadmap 3.7). Shown once
                 the window is on and Basalt isn't set to start at sign-in: first
                 as the offer right after switching it on, then as a plain notice. -->
            <ContentControl Style="{StaticResource CardTinted}" Margin="0,0,0,16"
                            Visibility="{Binding ShowStartupPanel, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{Binding StartupTitle}" Style="{StaticResource H2}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="SleepStartupTitle"/>
                        <TextBlock Text="{Binding StartupText}" Style="{StaticResource Body}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" AutomationProperties.AutomationId="SleepStartupText"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BtnPrimary}" Content="Start with Windows"
                                Command="{Binding TurnOnStartWithWindowsCommand}"
                                AutomationProperties.AutomationId="SleepStartWithWindowsButton"
                                AutomationProperties.Name="Turn on Start with Windows"/>
                        <Button Style="{StaticResource BtnGhost}" Content="Not now" Margin="8,0,0,0"
                                Command="{Binding DismissStartupOfferCommand}"
                                Visibility="{Binding StartupOfferPending, Converter={StaticResource BoolVis}}"
                                AutomationProperties.AutomationId="SleepStartupNotNowButton"
                                AutomationProperties.Name="Not now"/>
                    </StackPanel>
                </Grid>
            </ContentControl>

            <inf:AdaptiveColumns MinColumnWidth="400" MaxColumns="2" Spacing="16">

                <!-- status: the window at a glance -->
                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                            <!-- window ring (UI-SPEC.md A3): reuses the Today
                                 timer-ring visual language (§7) rather than
                                 inventing a new control, same 222px/12px ring,
                                 its arc rotated to start at the window's start time
                                 instead of always at 12 o'clock. The start/end
                                 labels stay inside it as the non-colour fallback, so
                                 the window is never colour-only information. -->
                            <Grid Width="222" Height="222" HorizontalAlignment="Center" Margin="0,4,0,24">
                                <Ellipse Width="222" Height="222" Stroke="{DynamicResource Track}" StrokeThickness="12"/>
                                <Ellipse Width="222" Height="222" Stroke="{DynamicResource Primary}" StrokeThickness="12"
                                         StrokeDashCap="Round"
                                         StrokeDashArray="{Binding WindowSweepFraction, Converter={StaticResource ProgressDash}}"
                                         Visibility="{Binding WindowSweepFraction, Converter={StaticResource PositiveVis}}"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="{Binding WindowStartAngle}"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconSleep}"
                                          Stroke="{DynamicResource PrimaryHover}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource H2}"
                                               Typography.NumeralAlignment="Tabular">
                                        <Run Text="{Binding StartText, Mode=OneWay}"/>
                                        <Run Text=" → "/>
                                        <Run Text="{Binding EndText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="Nightly window" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Center" Margin="0,0,0,0"
                                    Padding="16,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconSleep}"
                                               Margin="0,0,8,0" Stroke="{DynamicResource PrimaryHover}"/>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}"
                                               Foreground="{DynamicResource InkDim}"
                                               AutomationProperties.AutomationId="SleepStatusText"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding NextText}" Style="{StaticResource Body}" Margin="0,12,0,0"
                                       HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"
                                       Visibility="{Binding NextText, Converter={StaticResource NonEmptyVis}}"
                                       AutomationProperties.AutomationId="SleepNextText"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" HorizontalAlignment="Center"
                                       AutomationProperties.AutomationId="SleepWindowText">
                                <Run Text="Current window:"/>
                                <Run Text="{Binding WindowText, Mode=OneWay}" Foreground="{DynamicResource Ink}"/>
                            </TextBlock>
                    </StackPanel>
                </Border>

                <!-- schedule: switch it on and set the window -->
                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                            <CheckBox Style="{StaticResource Switch}"
                                      IsChecked="{Binding IsEnabled}"
                                      IsEnabled="{Binding HasAccess}"
                                      AutomationProperties.AutomationId="SleepBlockToggle"
                                      AutomationProperties.Name="Enable sleep blocking">
                                <StackPanel>
                                    <TextBlock Text="Scheduled sleep blocking" Style="{StaticResource H2}"/>
                                    <TextBlock Text="Blocks your list automatically inside the window below."
                                               Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </CheckBox>

                        <Border Height="1" Background="{DynamicResource Edge}" Margin="0,24,0,24"/>

                        <TextBlock Text="WINDOW" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>

                            <WrapPanel Orientation="Horizontal" IsEnabled="{Binding HasAccess}">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="STARTS" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox Style="{StaticResource TimePicker}" Width="76"
                                                  ItemsSource="{x:Static vm:SleepBlockingViewModel.HourOptions}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding StartHour}" TextSearch.TextPath="Label"
                                                  AutomationProperties.AutomationId="SleepStartHour"
                                                  AutomationProperties.Name="Sleep block start hour"/>
                                        <TextBlock Text=":" FontSize="18" Foreground="{DynamicResource InkFaint}"
                                                   VerticalAlignment="Center" Margin="6,0,6,2"/>
                                        <ComboBox Style="{StaticResource TimePicker}" Width="76"
                                                  ItemsSource="{x:Static vm:SleepBlockingViewModel.MinuteOptions}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding StartMinute}" TextSearch.TextPath="Label"
                                                  AutomationProperties.AutomationId="SleepStartMinute"
                                                  AutomationProperties.Name="Sleep block start minute"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="→" FontSize="18" Foreground="{DynamicResource InkFaint}"
                                           VerticalAlignment="Bottom" Margin="0,0,16,12"/>

                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="ENDS" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox Style="{StaticResource TimePicker}" Width="76"
                                                  ItemsSource="{x:Static vm:SleepBlockingViewModel.HourOptions}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding EndHour}" TextSearch.TextPath="Label"
                                                  AutomationProperties.AutomationId="SleepEndHour"
                                                  AutomationProperties.Name="Sleep block end hour"/>
                                        <TextBlock Text=":" FontSize="18" Foreground="{DynamicResource InkFaint}"
                                                   VerticalAlignment="Center" Margin="6,0,6,2"/>
                                        <ComboBox Style="{StaticResource TimePicker}" Width="76"
                                                  ItemsSource="{x:Static vm:SleepBlockingViewModel.MinuteOptions}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding EndMinute}" TextSearch.TextPath="Label"
                                                  AutomationProperties.AutomationId="SleepEndMinute"
                                                  AutomationProperties.Name="Sleep block end minute"/>
                                    </StackPanel>
                                </StackPanel>
                            </WrapPanel>

                            <TextBlock Text="24-hour time. A window that crosses midnight is fine."
                                       Style="{StaticResource Caption}" Margin="0,12,0,0"/>

                            <TextBlock Text="NIGHTS" Style="{StaticResource Eyebrow}" Margin="0,24,0,12"/>
                            <ItemsControl ItemsSource="{Binding Nights}" IsEnabled="{Binding HasAccess}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource SegmentCheck}" Margin="0,0,8,8"
                                                  Content="{Binding Label}" IsChecked="{Binding IsChosen}"
                                                  AutomationProperties.AutomationId="{Binding AutomationId}"
                                                  AutomationProperties.Name="{Binding AccessibleName}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="The window starts on the nights you pick, so a Friday window runs into Saturday morning."/>

                            <Button Style="{StaticResource BtnPrimary}" Content="Save window" HorizontalAlignment="Left"
                                    Margin="0,20,0,0" IsEnabled="{Binding HasAccess}" Command="{Binding SaveCommand}"
                                    AutomationProperties.AutomationId="SaveSleepWindowButton"
                                    AutomationProperties.Name="Save sleep window"/>
                    </StackPanel>
                </Border>
            </inf:AdaptiveColumns>
        </StackPanel>
    </ScrollViewer>
</UserControl>
