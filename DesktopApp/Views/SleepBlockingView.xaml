<UserControl x:Class="FlowShield.Views.SleepBlockingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The sleep window's settings, opened by Edit on Plans' sleep-blocking
         row (#433). The on/off switch is the row's own (SleepBlockToggle in
         ScheduleView); this is the window and its status. No ScrollViewer: the
         page scrolls, so a wheel turn over these fields moves the page.
         The ring and the two cards it replaced were the Schedule page's. -->
    <Border BorderBrush="{DynamicResource Edge}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
        <StackPanel>

            <!-- trial-ended gate (the window-wide lock screen normally covers this) -->
            <ContentControl Style="{StaticResource CardTinted}" Margin="0,0,0,16"
                            Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Your free trial has ended" Style="{StaticResource CardTitle}"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Buy Basalt once for $4.99 to keep your nightly shield."/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="Buy Basalt"
                            VerticalAlignment="Center" Command="{Binding GetProCommand}"
                            AutomationProperties.AutomationId="SleepGetProButton"/>
                </Grid>
            </ContentControl>

            <TextBlock Text="Blocks the blocklist in use every night, inside this window. A window that crosses midnight is fine."
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <WrapPanel Orientation="Horizontal" IsEnabled="{Binding HasAccess}">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Starts at" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource Field}" Width="112"
                             Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="SleepStartInput"
                             AutomationProperties.Name="Sleep block start time"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Ends at" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource Field}" Width="112"
                             Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="SleepEndInput"
                             AutomationProperties.Name="Sleep block end time"/>
                </StackPanel>

                <Button Style="{StaticResource BtnGhost}" Content="Save window"
                        VerticalAlignment="Bottom" Margin="0,8,12,0" Command="{Binding SaveCommand}"
                        AutomationProperties.AutomationId="SaveSleepWindowButton"
                        AutomationProperties.Name="Save sleep window"/>
                <Button Style="{StaticResource BtnQuiet}" Content="Done"
                        VerticalAlignment="Bottom" Margin="0,8,0,0"
                        Command="{Binding DataContext.CloseSleepEditorCommand,
                                  RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}"
                        AutomationProperties.AutomationId="SleepEditorDoneButton"
                        AutomationProperties.Name="Done editing sleep blocking"/>
            </WrapPanel>

            <TextBlock Text="24-hour time, such as 22:00." Style="{StaticResource Caption}" Margin="0,8,0,0"/>

            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource InkDim}"
                       AutomationProperties.AutomationId="SleepStatusText"/>
        </StackPanel>
    </Border>
</UserControl>
