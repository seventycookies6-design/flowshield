<UserControl x:Class="FlowShield.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FlowShield.Models"
             SizeChanged="OnSizeChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="StatsColumn" Width="320"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TimerRow" Height="*"/>
                <RowDefinition x:Name="StatsRow" Height="0"/>
            </Grid.RowDefinitions>

            <!-- ==================================================== timer card -->
            <Border x:Name="TimerCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,18,0" Padding="26"
                    VerticalAlignment="Top">
                <StackPanel>

                    <!-- ring -->
                    <Grid Width="212" Height="212" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Ellipse Width="196" Height="196" Stroke="{StaticResource Track}" StrokeThickness="12"/>
                        <Ellipse Width="196" Height="196" Stroke="{StaticResource Primary}" StrokeThickness="12"
                                 StrokeDashCap="Round"
                                 StrokeDashArray="{Binding Progress, Converter={StaticResource ProgressDash}}"
                                 Visibility="{Binding Progress, Converter={StaticResource PositiveVis}}"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding RemainingText}"
                                       FontSize="46" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}"
                                       HorizontalAlignment="Center"
                                       AutomationProperties.AutomationId="SprintTimerText"/>
                            <TextBlock Text="{Binding SessionStateText}" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"
                                       AutomationProperties.AutomationId="SessionStateText"/>
                            <!-- NoWrap so the trimming applies: the caption style wraps by
                                 default, and a long intention pushed itself out of the ring. -->
                            <TextBlock Text="{Binding IntentionDisplayText}" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0" MaxWidth="150"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding IntentionDisplayText}"
                                       Visibility="{Binding IntentionDisplayVisible, Converter={StaticResource BoolVis}}"
                                       AutomationProperties.AutomationId="SprintIntentionText"/>
                        </StackPanel>
                    </Grid>

                    <!-- primary action -->
                    <Button Style="{StaticResource BtnPrimary}" Content="Start sprint"
                            Command="{Binding StartCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource InvBoolVis}}"
                            HorizontalAlignment="Center" Padding="40,12" Margin="0,22,0,0"
                            AutomationProperties.AutomationId="StartSprintButton"
                            AutomationProperties.Name="Start sprint"/>

                    <!-- Label and behaviour depend on the shield and the grace period (F2). -->
                    <Button Style="{StaticResource BtnGhost}" Content="{Binding EndButtonLabel}"
                            Command="{Binding StopCommand}"
                            Visibility="{Binding EndButtonVisible, Converter={StaticResource BoolVis}}"
                            HorizontalAlignment="Center" Padding="40,12" Margin="0,22,0,0"
                            AutomationProperties.AutomationId="StopSprintButton"
                            AutomationProperties.Name="{Binding EndButtonLabel}"/>

                    <!-- End panel: Firm's confirmation and Sealed's countdown and phrase. -->
                    <Border Style="{StaticResource RowCard}" Margin="0,22,0,0" Padding="18"
                            Visibility="{Binding EndPanelVisible, Converter={StaticResource BoolVis}}"
                            AutomationProperties.AutomationId="EndSprintPanel">
                        <StackPanel>
                            <TextBlock Text="{Binding EndPanelTitle}" Style="{StaticResource H2}" FontSize="15"
                                       AutomationProperties.AutomationId="EndPanelTitle"/>
                            <TextBlock Text="{Binding EndPanelText}" Style="{StaticResource Body}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                       AutomationProperties.AutomationId="EndPanelText"/>

                            <TextBox Style="{StaticResource Field}" Margin="0,12,0,0"
                                     Text="{Binding PhraseText, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding PhraseRequired, Converter={StaticResource BoolVis}}"
                                     AutomationProperties.AutomationId="EndPhraseInput"
                                     AutomationProperties.Name="Type end my sprint to confirm"/>

                            <TextBlock Text="{Binding EndCountdownText}" Style="{StaticResource Caption}"
                                       Margin="0,8,0,0"
                                       AutomationProperties.AutomationId="EndCountdownText"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource BtnPrimary}" Content="Keep going"
                                        Command="{Binding KeepGoingCommand}" Padding="22,9"
                                        AutomationProperties.AutomationId="KeepGoingButton"/>
                                <Button Style="{StaticResource BtnQuiet}" Content="End anyway"
                                        Command="{Binding EndAnywayCommand}"
                                        IsEnabled="{Binding EndAnywayEnabled}" Margin="10,0,0,0"
                                        AutomationProperties.AutomationId="EndAnywayButton"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- length -->
                    <TextBlock Text="SPRINT LENGTH" Style="{StaticResource Eyebrow}" Margin="0,26,0,9"/>
                    <WrapPanel IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}}">
                        <RadioButton Style="{StaticResource Segment}" GroupName="SprintLength" Content="15 min"
                                     Margin="0,0,8,8"
                                     AutomationProperties.AutomationId="SprintLength_15"
                                     AutomationProperties.Name="15 minute sprint"
                                     IsChecked="{Binding PresetMinutes, Converter={StaticResource IntEq},
                                                 ConverterParameter=15}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="SprintLength" Content="25 min"
                                     Margin="0,0,8,8"
                                     AutomationProperties.AutomationId="SprintLength_25"
                                     AutomationProperties.Name="25 minute sprint"
                                     IsChecked="{Binding PresetMinutes, Converter={StaticResource IntEq},
                                                 ConverterParameter=25}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="SprintLength" Content="45 min"
                                     Margin="0,0,8,8"
                                     AutomationProperties.AutomationId="SprintLength_45"
                                     AutomationProperties.Name="45 minute sprint"
                                     IsChecked="{Binding PresetMinutes, Converter={StaticResource IntEq},
                                                 ConverterParameter=45}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="SprintLength" Content="60 min"
                                     Margin="0,0,8,8"
                                     AutomationProperties.AutomationId="SprintLength_60"
                                     AutomationProperties.Name="60 minute sprint"
                                     IsChecked="{Binding PresetMinutes, Converter={StaticResource IntEq},
                                                 ConverterParameter=60}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="SprintLength" Content="90 min"
                                      Margin="0,0,8,8"
                                      AutomationProperties.AutomationId="SprintLength_90"
                                      AutomationProperties.Name="90 minute sprint"
                                      IsChecked="{Binding PresetMinutes, Converter={StaticResource IntEq},
                                                  ConverterParameter=90}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="SprintLength" Content="Custom…"
                                      Margin="0,0,8,8"
                                      AutomationProperties.AutomationId="SprintLength_Custom"
                                      AutomationProperties.Name="Custom sprint length"
                                      IsChecked="{Binding IsCustomSelected}"/>
                    </WrapPanel>

                    <StackPanel Margin="0,0,0,8"
                                Visibility="{Binding CustomInputVisible, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="70" Style="{StaticResource Field}"
                                     Text="{Binding CustomMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="CustomMinutesInput"
                                     AutomationProperties.Name="Custom minutes"/>
                            <TextBlock Text="min (5–240)" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CustomMinutesError}" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Amber}" Margin="0,6,0,0"
                                   Visibility="{Binding CustomMinutesErrorVisible, Converter={StaticResource BoolVis}}"
                                   AutomationProperties.AutomationId="CustomMinutesError"/>
                    </StackPanel>

                    <!-- shield level -->
                    <TextBlock Text="SHIELD LEVEL" Style="{StaticResource Eyebrow}" Margin="0,14,0,9"/>
                    <StackPanel Orientation="Horizontal"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}}">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Shield" Content="I · Soft"
                                     AutomationProperties.AutomationId="Shield_Soft"
                                     AutomationProperties.Name="Shield I Soft"
                                     IsChecked="{Binding SelectedShield, Converter={StaticResource EnumEq},
                                                 ConverterParameter={x:Static models:ShieldLevel.Soft}}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Shield" Content="II · Firm"
                                     AutomationProperties.AutomationId="Shield_Firm"
                                     AutomationProperties.Name="Shield II Firm"
                                     IsChecked="{Binding SelectedShield, Converter={StaticResource EnumEq},
                                                 ConverterParameter={x:Static models:ShieldLevel.Firm}}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Shield" Content="III · Sealed"
                                     AutomationProperties.AutomationId="Shield_Sealed"
                                     AutomationProperties.Name="Shield III Sealed"
                                     IsChecked="{Binding SelectedShield, Converter={StaticResource EnumEq},
                                                 ConverterParameter={x:Static models:ShieldLevel.Sealed}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ShieldDescription}" Style="{StaticResource Caption}"
                               Margin="0,10,0,0"
                               AutomationProperties.AutomationId="ShieldDescriptionText"/>
                    <TextBlock Text="{Binding ShieldBestFor}" Style="{StaticResource Caption}"
                               Margin="0,4,0,0"
                               AutomationProperties.AutomationId="ShieldBestForText"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource Amber}"
                               Visibility="{Binding SealedRestartHintVisible, Converter={StaticResource BoolVis}}"
                               AutomationProperties.AutomationId="SealedRestartHint"
                               Text="If FlowShield closes, a Sealed sprint picks up again when it reopens. After a reboot that only happens by itself if FlowShield starts with Windows (Settings → Preferences)."/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource Amber}"
                               Visibility="{Binding SoftHardKillHintVisible, Converter={StaticResource BoolVis}}"
                               AutomationProperties.AutomationId="SoftHardKillHint"
                               Text="Hard kill mode is on (Settings), so Soft closes blocked apps instead of nudging."/>

                    <!-- intention (F13) -->
                    <TextBlock Text="INTENTION" Style="{StaticResource Eyebrow}" Margin="0,26,0,9"/>
                    <TextBox Style="{StaticResource Field}" MaxLength="80"
                             Text="{Binding IntentionText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}}"
                             AutomationProperties.AutomationId="IntentionInput"
                             AutomationProperties.Name="What are you working on?"/>
                    <TextBlock Text="Optional. It's shown on the timer and again when the sprint ends."
                               Style="{StaticResource Caption}" Margin="0,6,0,0"/>

                    <!-- sprint summary (F12) -->
                    <Border Style="{StaticResource RowCard}" Margin="0,22,0,0" Padding="16"
                            Visibility="{Binding JournalPromptVisible, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SummaryTitle}" Style="{StaticResource H2}" FontSize="14"
                                       AutomationProperties.AutomationId="SummaryTitle"/>
                            <TextBlock Text="{Binding SummaryMinutesText}" Style="{StaticResource Body}"
                                       Margin="0,8,0,0"
                                       AutomationProperties.AutomationId="SummaryMinutesValue"/>
                            <TextBlock Text="{Binding SummaryDistractionsText}" Style="{StaticResource Body}"
                                       Margin="0,4,0,0"
                                       AutomationProperties.AutomationId="SummaryDistractionsValue"/>
                            <TextBlock Text="{Binding SummaryMomentumText}" Style="{StaticResource Body}"
                                       Margin="0,4,0,0"
                                       AutomationProperties.AutomationId="SummaryMomentumText"/>
                            <TextBlock Text="{Binding SummaryStreakText}" Style="{StaticResource Body}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding SummaryStreakVisible, Converter={StaticResource BoolVis}}"
                                       AutomationProperties.AutomationId="SummaryStreakText"/>
                            <TextBlock Text="{Binding SummaryIntentionText}" Style="{StaticResource Body}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding SummaryIntentionVisible, Converter={StaticResource BoolVis}}"
                                       AutomationProperties.AutomationId="SummaryIntentionText"/>
                        </StackPanel>
                    </Border>

                    <!-- journal prompt -->
                    <Border Style="{StaticResource RowCard}" Margin="0,22,0,0" Padding="16"
                            Visibility="{Binding JournalPromptVisible, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding JournalPromptTitle}" Style="{StaticResource H2}" FontSize="14"
                                       AutomationProperties.AutomationId="JournalPromptTitle"/>
                            <TextBlock Text="One line. You'll thank yourself in three months."
                                       Style="{StaticResource Caption}" Margin="0,2,0,10"/>
                            <TextBox Style="{StaticResource Field}"
                                     Text="{Binding JournalText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="JournalInput"
                                     AutomationProperties.Name="Session journal"/>
                            <Button Style="{StaticResource BtnGhost}" Content="Save entry"
                                    Command="{Binding SaveJournalCommand}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    AutomationProperties.AutomationId="SaveJournalButton"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================================================== stats rail -->
            <StackPanel x:Name="StatsRail" Grid.Row="0" Grid.Column="1" VerticalAlignment="Top">

                <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="MOMENTUM" Style="{StaticResource Eyebrow}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding MomentumText}" FontSize="42" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}"
                                       AutomationProperties.AutomationId="MomentumValue"/>
                            <TextBlock Text="pts" Style="{StaticResource Caption}" VerticalAlignment="Bottom"
                                       Margin="7,0,0,10"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                                   AutomationProperties.AutomationId="StreakText">
                            <Run Text="Streak:"/>
                            <Run Text="{Binding StreakText, Mode=OneWay}" Foreground="{StaticResource PrimaryHover}"/>
                        </TextBlock>
                        <TextBlock Text="Finished sprints compound. Abandoned ones decay — they don't reset."
                                   Style="{StaticResource Caption}" Margin="0,10,0,0"/>

                        <!-- F14: the 30-day trend. DESIGN_SYSTEM.md "Charts" —
                             one series in primary at 2 px, no area fill,
                             horizontal gridlines in border, captions faint. -->
                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding TrendVisible, Converter={StaticResource BoolVis}}">
                            <!-- No AutomationId on this Grid: a layout panel is
                                 not surfaced to UI Automation, so an id here
                                 can never be found and a test looking for it
                                 would pass or fail for the wrong reason. The
                                 two captions below are real controls, and they
                                 carry the chart's accessible description —
                                 which a screen reader can actually use, unlike
                                 a name on a drawn line. -->
                            <Grid Height="64" Width="250" HorizontalAlignment="Left">
                                <Line X1="0" Y1="0" X2="250" Y2="0"
                                      Stroke="{StaticResource Edge}" StrokeThickness="1"/>
                                <Line X1="0" Y1="32" X2="250" Y2="32"
                                      Stroke="{StaticResource Edge}" StrokeThickness="1"/>
                                <Line X1="0" Y1="63" X2="250" Y2="63"
                                      Stroke="{StaticResource Edge}" StrokeThickness="1"/>
                                <Polyline Points="{Binding TrendPoints}"
                                          Stroke="{StaticResource Primary}" StrokeThickness="2"
                                          StrokeLineJoin="Round"/>
                            </Grid>
                            <Grid Margin="0,6,0,0" Width="250" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding TrendRangeText}" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Left"
                                           AutomationProperties.Name="{Binding TrendDescription}"
                                           AutomationProperties.AutomationId="MomentumTrendRange"/>
                                <TextBlock Text="{Binding TrendCeilingText}" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right"
                                           AutomationProperties.AutomationId="MomentumTrendPeak"/>
                            </Grid>
                        </StackPanel>

                        <!-- F14: the rule in plain words, folded away by default
                             so the card still leads with the number. -->
                        <Button Style="{StaticResource BtnQuiet}" HorizontalAlignment="Left"
                                Margin="-10,8,0,0"
                                Content="{Binding ExplainerToggleText}"
                                Command="{Binding ToggleExplainerCommand}"
                                AutomationProperties.AutomationId="MomentumExplainerButton"/>
                        <ItemsControl ItemsSource="{Binding MomentumExplanation}" Margin="0,4,0,0"
                                      Visibility="{Binding ExplainerVisible, Converter={StaticResource BoolVis}}"
                                      AutomationProperties.AutomationId="MomentumExplainerText">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="TODAY" Style="{StaticResource Eyebrow}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Sprints completed" Style="{StaticResource Body}"/>
                            <TextBlock Text="{Binding SessionsToday}" HorizontalAlignment="Right"
                                       Foreground="{StaticResource Ink}" FontWeight="SemiBold"
                                       AutomationProperties.AutomationId="SessionsTodayValue"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Focus minutes" Style="{StaticResource Body}"/>
                            <TextBlock Text="{Binding FocusMinutesToday}" HorizontalAlignment="Right"
                                       Foreground="{StaticResource Ink}" FontWeight="SemiBold"
                                       AutomationProperties.AutomationId="FocusMinutesValue"/>
                        </Grid>

                        <Grid>
                            <TextBlock Text="Distractions blocked" Style="{StaticResource Body}"/>
                            <TextBlock Text="{Binding BlocksToday}" HorizontalAlignment="Right"
                                       Foreground="{StaticResource Ink}" FontWeight="SemiBold"
                                       AutomationProperties.AutomationId="BlocksTodayValue"/>
                        </Grid>

                        <!-- Daily goal (F15). Hidden entirely when no goal is set. -->
                        <!-- No AutomationId here: a layout panel is not surfaced to UI
                             Automation, so one could never be resolved and a test asking
                             for it would pass whether the bar was drawn or not (#134).
                             DailyGoalProgressText and DailyGoalBar below are the handles. -->
                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding GoalVisible, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <TextBlock Text="Daily goal" Style="{StaticResource Body}"/>
                                <TextBlock Text="{Binding GoalProgressText}" HorizontalAlignment="Right"
                                           Foreground="{StaticResource Ink}" FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="DailyGoalProgressText"/>
                            </Grid>
                            <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="1"
                                         Value="{Binding GoalFraction, Mode=OneWay}"
                                         Style="{StaticResource GoalBar}"
                                         AutomationProperties.AutomationId="DailyGoalBar"
                                         AutomationProperties.Name="{Binding GoalProgressText}"/>
                            <TextBlock Text="{Binding GoalNoteText}" Style="{StaticResource Caption}"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding GoalNoteText, Converter={StaticResource NonEmptyVis}}"
                                       AutomationProperties.AutomationId="DailyGoalNote"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
