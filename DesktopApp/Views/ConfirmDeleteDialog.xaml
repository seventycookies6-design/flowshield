<Window x:Class="FlowShield.Views.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowShield"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource FontStack}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AutomationProperties.AutomationId="ConfirmDeleteDialog">
    <!-- DESIGN_SYSTEM.md §7 destructive pattern: BtnDanger sits beside a plain
         Cancel, never alone, and the copy says exactly what is about to happen
         (§9 voice — no exclamation marks, no scare language). The text below is
         Delete everything's; other deletes pass their own question and button
         label to the code-behind's second constructor. -->
    <Border Style="{StaticResource Card}" Margin="16" Padding="24">
        <StackPanel>
            <TextBlock x:Name="QuestionText" Text="Delete everything on this PC."
                       Style="{StaticResource H2}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="ConfirmDeleteText"/>
            <TextBlock x:Name="DetailText" Text="This removes your sessions, journal, blocklist profiles, templates, schedules, momentum and licence from this computer, and empties FlowShield's taskbar Jump List. If FlowShield is licensed here, that seat is freed for another machine first. This cannot be undone."
                       Style="{StaticResource Body}" Margin="0,12,0,0" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="ConfirmDeleteDetailText"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <!-- IsCancel, rather than a Click handler: it closes the dialog
                     with DialogResult false exactly as the old handler did, and
                     it also makes Escape do it (§13). Both together would set
                     DialogResult twice, the second time after the close. -->
                <Button Style="{StaticResource BtnGhost}" Content="Cancel"
                        IsCancel="True" Padding="16,8"
                        AutomationProperties.AutomationId="ConfirmDeleteCancelButton"
                        AutomationProperties.Name="Cancel"/>
                <Button x:Name="ConfirmButton" Style="{StaticResource BtnDanger}" Content="Delete everything"
                        Click="OnConfirm" Margin="12,0,0,0" Padding="24,8"
                        AutomationProperties.AutomationId="ConfirmDeleteConfirmButton"
                        AutomationProperties.Name="Delete everything"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
