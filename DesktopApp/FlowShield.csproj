<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FlowShield</AssemblyName>
    <RootNamespace>FlowShield</RootNamespace>
    <ApplicationIcon>Assets\FlowShield.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>FlowShield</Product>
    <Company>FlowShield</Company>
    <!-- Single-instance + tray behaviour relies on STA; default for WPF. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Program.Main instead of the one WPF generates, so the Velopack
         install/update/uninstall hooks run before anything else exists. -->
    <StartupObject>FlowShield.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Demote App.xaml from ApplicationDefinition to Page: an
         ApplicationDefinition generates its own Main, which would collide with
         Program.Main above. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app picker's suggestions (F8). Plain data so anyone can add an app. -->
    <EmbeddedResource Include="Data\app_suggestions.json" LogicalName="FlowShield.app_suggestions.json" />
    <Resource Include="Assets\FlowShield.ico" />
    <Resource Include="Assets\FlowShield.Running.ico" />
    <!-- Ships beside the exe: the Lucide icons are ISC and the runtime and
         Velopack are MIT, and all three require their notice to travel with
         the binary (LEGAL_CHECKLIST 8.2). -->
    <Content Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Inter (SIL Open Font License), embedded so the app never depends on a
         web font service or what happens to be installed on the customer's
         machine (DESIGN_SYSTEM.md §3). Only the weights the §3 scale actually
         uses in-app — Bold is a site-hero-only weight, so it isn't embedded
         here. -->
    <Resource Include="Assets\Fonts\Inter-Regular.ttf" />
    <Resource Include="Assets\Fonts\Inter-Medium.ttf" />
    <Resource Include="Assets\Fonts\Inter-SemiBold.ttf" />
    <!-- Inter Display, the tighter optical size §3 allows for the timer and
         stat numbers (UI-SPEC.md A4): one static weight, SemiBold, since
         nothing in the scale needs any other Display weight. -->
    <Resource Include="Assets\Fonts\InterDisplay-SemiBold.ttf" />
    <!-- Copied to the output, not just kept in the repo: the OFL asks for
         its text to travel with the font, and embedded resources carry the
         font but not the licence. THIRD-PARTY-NOTICES.txt points at it. -->
    <Content Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Installer + auto-update. Without an update channel a shipped bug is
         permanent for everyone who already installed. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is referenced only for the tray icon. Its implicit global using
         collides with WPF (Application, UserControl, MessageBox, ...), so it is
         removed and reached through the `Forms` alias where it is actually needed. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
